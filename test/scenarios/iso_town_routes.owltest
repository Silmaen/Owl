# The isometric town: a road bulldozed under a vehicle, then a bypass built beside it. The truck (stopping on its way down
# the western side of the ring) stands on the bulldozed cell (6, 13); it drives off to the road cell it came from, takes the
# bypass that joins the spur (5, 12) to the ring corner (6, 16) and carries on, instead of waiting for the same cell to be
# built again. F3 shows the road graph and the routes of the vehicles. The headless view is 1600x960 centred on the camera at
# (12, 12): the centre of cell (x, y) is at pixel (800 + 32 * (x - y), 480 + 16 * (x + y - 23)).
scene: assets/iso_town_small.owl
project: ../../engine_demo
assets: assets
steps:
  - frames: 41
  - expect: {gamestate: town_debug, equals: 0}
  - input: {key: F3, frames: 2}
  - expect: {gamestate: town_debug, equals: 1}
  - frames: 2
  - input: {key: F3, frames: 2}
  - expect: {gamestate: town_debug, equals: 0}
  # Bulldoze the cell (6, 13) under the truck.
  - input: {mouse_pos: [576, 416], frames: 2}
  - expect: {gamestate: town_cursor_x, equals: 6}
  - expect: {gamestate: town_cursor_y, equals: 13}
  - input: {mouse: Right, mouse_pos: [576, 416], frames: 3}
  - expect: {gamestate: town_reroutes, greater: 0}
  - frames: 60
  # The bypass (5, 13) to (5, 16), a road added next to the cut one.
  - input: {mouse: Left, mouse_pos: [544, 400], frames: 3}
  - input: {mouse: Left, mouse_pos: [512, 416], frames: 3}
  - input: {mouse: Left, mouse_pos: [480, 432], frames: 3}
  - input: {mouse: Left, mouse_pos: [448, 448], frames: 3}
  - expect: {gamestate: town_roads, equals: 4}
  - frames: 400
  - expect: {entity: Truck, translation.x: {greater: 7}}
  - expect: {gamestate: town_longest_wait, less: 4}
  - expect: {gamestate: town_offroad, equals: 0}
  - expect: {gamestate: town_bad_uturns, equals: 0}
  - expect: {gamestate: town_route_calls, greater: 10}
