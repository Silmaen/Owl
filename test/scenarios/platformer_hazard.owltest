# Walking right into the hazard drains the player's health: the runner switches to the game-over scene.
scene: ../../engine_demo/scenes/platformer_house.owl
steps:
  - frames: 30
  - expect: {entity: GameOverTitle, exists: false}
  - input: {key: Right, frames: 90}
  - frames: 180
  - expect: {entity: GameOverTitle, exists: true}
