# The inventory demo with actions only: a locked door refuses a player without its key, the gold key is picked up, the
# inventory window opens with the `inventory` action (then with a gamepad button), `ui_*` actions walk its slots, the
# key opens the door and is used up, the blue key and the vault switch lead to the crown.
scene: ../../sample_project/scenes/inventory_demo.owl
steps:
  # The fade-in of the scene holds the player for 0.4 s.
  - frames: 40
  - expect: {entity: GoldDoor, exists: true}
  - expect: {entity: PickupGoldKey, exists: true}
  - expect: {gamestate: inv_window_open, equals: 0}
  # No key yet: the door stays shut.
  - actions: {move: [1, 0], frames: 60}
  - actions: {interact: true, frames: 1}
  - frames: 3
  - expect: {entity: GoldDoor, exists: true}
  # Back to the gold key, which is picked up on contact.
  - actions: {move: [-1, 0], frames: 60}
  - actions: {move: [0, -1], frames: 35}
  - frames: 3
  - expect: {entity: PickupGoldKey, exists: false}
  - expect: {gamestate: inv_key_yellow, equals: 1}
  # The inventory window opens, the focus starts on the filled slot.
  - actions: {inventory: true, frames: 1}
  - frames: 5
  - expect: {gamestate: inv_window_open, equals: 1}
  - expect: {gamestate: inv_focus, equals: 1}
  - actions: {ui_right: true, frames: 1}
  - frames: 2
  - expect: {gamestate: inv_focus, equals: 2}
  - actions: {ui_down: true, frames: 1}
  - frames: 2
  - expect: {gamestate: inv_focus, equals: 5}
  - actions: {ui_left: true, frames: 1}
  - frames: 2
  - expect: {gamestate: inv_focus, equals: 4}
  - actions: {ui_up: true, frames: 1}
  - frames: 2
  - expect: {gamestate: inv_focus, equals: 1}
  - actions: {ui_accept: true, frames: 1}
  - frames: 2
  - expect: {gamestate: inv_selected, equals: 1}
  # No wrap: nothing is left of the first slot.
  - actions: {ui_left: true, frames: 1}
  - frames: 2
  - expect: {gamestate: inv_focus, equals: 1}
  # ui_cancel closes the window, a gamepad button opens it again, the `inventory` action closes it.
  - actions: {ui_cancel: true, frames: 1}
  - frames: 3
  - expect: {gamestate: inv_window_open, equals: 0}
  - input: {gamepad: {button: Y}, frames: 1}
  - frames: 5
  - expect: {gamestate: inv_window_open, equals: 1}
  # The player stays still while the window is open.
  - expect: {player: true, translation.x: {equals: -7.948, tolerance: 0.01}}
  - actions: {move: [1, 0], frames: 20}
  - expect: {player: true, translation.x: {equals: -7.948, tolerance: 0.01}}
  - actions: {inventory: true, frames: 1}
  - frames: 3
  - expect: {gamestate: inv_window_open, equals: 0}
  # With the key, the door opens and the key is used up.
  - actions: {move: [0, 1], frames: 35}
  - actions: {move: [1, 0], frames: 60}
  - actions: {interact: true, frames: 1}
  - frames: 3
  - expect: {entity: GoldDoor, exists: false}
  - expect: {gamestate: inv_key_yellow, equals: 0}
  # Through the door: the blue key, then the vault switch and the crown.
  - actions: {move: [1, 0], frames: 70}
  - expect: {gamestate: inv_key_blue, equals: 1}
  - actions: {move: [1, 0], frames: 20}
  - actions: {interact: true, frames: 1}
  - frames: 3
  - expect: {entity: VaultGate, exists: false}
  - expect: {gamestate: inv_key_blue, equals: 0}
  - actions: {move: [1, 0], frames: 60}
  - expect: {gamestate: inv_treasure_crown, equals: 1}
