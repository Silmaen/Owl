# Walking over the first coins of the meadow scores 10 each; a collected coin pops and is destroyed.
scene: ../../engine_demo/scenes/platformer_house.owl
steps:
  - frames: 30
  - expect: {entity: Coin1, exists: true}
  - input: {key: Right, frames: 60}
  - frames: 30
  - expect: {gamestate: score, greater: 19}
  - expect: {entity: Coin1, exists: false}
