# The hub's villager walks from point to point over the `walkable` navigation layer of the world map (cells mode):
# it reaches its first point after crossing the town round the houses and trees, and never steps onto a cell outside the
# graph. About 24 cells at 1.9 cells per second.
scene: ../../engine_demo/scenes/world_map.owl
steps:
  - frames: 60
  - expect: {entity: Villager, exists: true}
  - expect: {gamestate: villager_route_cells, greater: 15}
  - expect: {gamestate: villager_trips, equals: 0}
  # The other villagers pace along their street on a plain Lua loop.
  - expect: {entity: Wizard, translation.x: {greater: 12.6}}
  - expect: {entity: Knight, translation.x: {greater: -2.0}}
  - frames: 840
  - expect: {gamestate: villager_trips, greater: 0}
  - expect: {entity: Villager, translation.x: {greater: 10}}
  - frames: 600
  - expect: {gamestate: villager_trips, greater: 1}
  - expect: {gamestate: villager_offgrid, equals: 0}
