# The isometric town without the mouse: the `cursor` action walks the cell cursor over the map (J K L I, the right
# stick), `build` lays a road under it, `town_tool` switches to the bulldozer and `build` then removes it again.
scene: ../../engine_demo/scenes/iso_town_small.owl
steps:
  - frames: 30
  # Five steps down the screen from the middle of the plaza, to a grass cell below the ring road.
  - actions: {cursor: [0, 1], frames: 42}
  - actions: {frames: 2}
  - expect: {gamestate: town_cursor_x, equals: 17}
  - expect: {gamestate: town_cursor_y, equals: 17}
  - actions: {build: true, frames: 2}
  - actions: {frames: 2}
  - expect: {gamestate: town_roads, equals: 1}
  - expect: {gamestate: town_money, less: 995}
  - actions: {town_tool: true, frames: 1}
  - actions: {build: true, frames: 2}
  - actions: {frames: 2}
  - expect: {gamestate: town_roads, equals: 0}
  - expect: {gamestate: town_tool, equals: 2}
