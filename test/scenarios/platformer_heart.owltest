# A heart restores a third of the health bar once and is destroyed after its pop; a full bar leaves it alone. (The spike
# brings the health down, the heart that already covers the player takes it back up within a few frames.)
scene: ../../engine_demo/scenes/platformer_house.owl
steps:
  - frames: 30
  - {command: entity.set_transform, args: {entity: Heart1, translation: [4.5, -14.4, 0.3], scale: [60, 60, 1]}}
  - frames: 20
  - expect: {entity: Heart1, exists: true}
  - {command: entity.set_transform, args: {entity: Spike1, translation: [4.5, -14.4, 0.1], scale: [60, 60, 1]}}
  - frames: 25
  - expect: {gamestate: health, equals: 1.0, tolerance: 0.01}
  - frames: 30
  - expect: {entity: Heart1, exists: false}
