# The secret room of the farm cliff: its coins stay hidden (and untouchable) until the plug of dirt opens. The first one
# waits on the player while hidden; once the wall is open it and the second one are collected.
scene: ../../engine_demo/scenes/platformer_house.owl
steps:
  - frames: 30
  - {command: entity.set_transform, args: {entity: SecretItem1, translation: [4.5, -14.4, 0.3]}}
  - frames: 10
  - {command: entity.set_transform, args: {entity: SecretRoom, translation: [4.5, -14.4, 0.1]}}
  - frames: 10
  - expect: {gamestate: platformer_secret, equals: 1}
  - {command: entity.set_transform, args: {entity: SecretItem2, translation: [4.5, -14.4, 0.3]}}
  - frames: 10
  - expect: {gamestate: score, equals: 20}
