# Tower defence title: How to play opens its window with the keyboard focus and Escape closes it; Play (the first
# button, focused) opens the world map behind a wipe.
scene: ../../../samples/tower_defence/scenes/title.owl
steps:
  - frames: 40
  - expect: {gamestate: tower_title, equals: true}
  - input: {key: Down, frames: 2}
  - frames: 2
  - input: {key: Enter, frames: 2}
  - frames: 2
  - expect: {gamestate: tower_how_to, equals: true}
  - input: {key: Escape, frames: 2}
  - frames: 2
  - expect: {gamestate: tower_how_to, equals: false}
  - input: {key: Up, frames: 2}
  - frames: 2
  - input: {key: Enter, frames: 2}
  - frames: 120
  - expect: {entity: Site, exists: true}
  - expect: {gamestate: tower_map, equals: true}
