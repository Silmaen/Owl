# The isometric town and its trees: a road laid on a cell clears the trees standing there, the bulldozer removes a tree
# for a small fee. The headless view is 1600x960 centred on the camera at (12, 12): the centre of cell (x, y) is at pixel
# (800 + 32 * (x - y), 480 + 16 * (x + y - 23)), 8 pixels higher per half unit of height. The trees of the fixture stand
# in cell (8, 2) at height 0 and in cell (1, 4) at height 0.5.
scene: ../test_helper/assets/scenarios/iso_town_small.owl
project: ../../../engine_demo
assets: ../test_helper/assets/scenarios
steps:
  - frames: 30
  - expect: {gamestate: town_trees_left, equals: 21}
  - expect: {gamestate: town_trees, equals: 0}
  # A road on the tree cell: the tree is gone, the road is built.
  - input: {mouse: Left, mouse_pos: [992, 272], frames: 4}
  - expect: {gamestate: town_roads, equals: 1}
  - expect: {gamestate: town_trees, equals: 1}
  - expect: {gamestate: town_trees_left, equals: 20}
  # The bulldozer removes the tree of another cell and charges 3.
  - input: {mouse: Right, mouse_pos: [704, 184], frames: 4}
  - expect: {gamestate: town_trees, equals: 2}
  - expect: {gamestate: town_trees_left, equals: 19}
  - expect: {gamestate: town_money, equals: 987}
  - expect: {gamestate: town_roads, equals: 1}
