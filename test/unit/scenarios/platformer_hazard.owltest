# Walking right into the first water pit costs a third of the health, respawns the player at the start behind a fade and,
# the third time, ends the run: the runner switches to the game-over scene.
scene: ../../../engine_demo/scenes/platformer_house.owl
steps:
  - frames: 30
  - expect: {entity: GameOverTitle, exists: false}
  - expect: {gamestate: health, equals: 1}
  - input: {key: Right, frames: 150}
  - frames: 100
  - expect: {gamestate: health, less: 0.7}
  - expect: {gamestate: health, greater: 0.6}
  - expect: {player: true, translation.x: {less: 6.0}}
  - expect: {entity: GameOverTitle, exists: false}
  - input: {key: Right, frames: 150}
  - frames: 100
  - expect: {gamestate: health, less: 0.4}
  - input: {key: Right, frames: 150}
  - frames: 180
  - expect: {entity: GameOverTitle, exists: true}
