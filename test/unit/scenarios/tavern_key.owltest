# The tavern: the cellar key lies on the floor by the hearth, whose world box holds it; aimed at from a step away, E
# takes it (an interaction answers what a first-person walker aims at, a coarse box around it does not hide it).
scene: ../../../engine_demo/scenes/tavern.owl
project: ../../../engine_demo
steps:
  - frames: 60
  - expect: {gamestate: tavern_key, equals: 0}
  - {command: entity.set_transform, args: {entity: TavernCamera, translation: [-1.9, 1.6, -1.4], rotation: [-1.0, 0.33, 0]}}
  - frames: 30
  - input: {key: E, frames: 3}
  - frames: 10
  - expect: {gamestate: tavern_key, equals: 1}
