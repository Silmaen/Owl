# The Sunken Shrine, the slime pit: the hero walks round the rock in the middle up to the chest and opens it (E): the
# key is found.
scene: ../../../samples/sunken_shrine/scenes/room_2.owl
steps:
  - frames: 5
  - input: {key: A, frames: 27}
  - input: {key: W, frames: 70}
  - input: {key: D, frames: 12}
  - input: {key: E, frames: 1}
  - frames: 3
  - expect: {gamestate: shrine_chest, equals: true}
  - expect: {gamestate: shrine_key, equals: true}
