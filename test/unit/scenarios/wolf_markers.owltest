# Wolfenstein mini: the HUD markers of floor 1 (explore.lua) show once their cell was seen: the gold key, next to the
# start, has its marker at once, the far exit not yet. Taking the key bursts the gold sparks ahead of the view
# (pickup.lua) and its marker goes with it.
scene: ../../../samples/wolfenstein/scenes/level_1.owl
project: ../../../samples/wolfenstein
steps:
  - frames: 30
  - expect: {gamestate: wolf_markers, equals: 1}
  - actions: {turn: 1, frames: 105}
  - actions: {walk: 1, frames: 40}
  - frames: 3
  - expect: {gamestate: wolf_key_gold, equals: 1}
  - expect: {gamestate: wolf_sparkles, equals: 1}
  - expect: {entity: GoldKey, exists: false}
  - expect: {gamestate: wolf_markers, equals: 1}
