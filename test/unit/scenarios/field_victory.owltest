# Asteroid Field victory: the tally of the mission comes line by line and the best score is kept; Play again flies
# the mission again.
scene: ../../../samples/asteroid_field/scenes/victory.owl
steps:
  - frames: 10
  - expect: {entity: ScoreLabel, exists: true}
  - expect: {gamestate: field_tally, equals: true}
  - input: {key: Enter, frames: 2}
  - frames: 60
  - expect: {gamestate: field_state, equals: fly}
