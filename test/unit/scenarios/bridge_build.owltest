  - expect: {gamestate: bridge_state, equals: run}
  - expect: {gamestate: bridge_breaks, equals: 0}
  - frames: 840
  - expect: {gamestate: bridge_state, equals: won}
  - expect: {gamestate: bridge_arrived, equals: 1}
  - expect: {gamestate: bridge_stars, greater: 0}
  - expect: {setting: bridge_done_1, equals: true}
