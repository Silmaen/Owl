# The raycast player walks forward (W) along its view direction; the dot of the minimap (a 2D layer drawn over the
# raycast view) follows it, three screen pixels per cell.
scene: ../../../engine_demo/scenes/raycast_demo.owl
steps:
  - frames: 30
  - expect: {player: true, translation.x: {equals: -3.094, tolerance: 0.01}}
  - expect: {entity: Minimap, exists: true}
  - expect: {gamestate: minimap_x, equals: 110.7, tolerance: 0.5}
  - input: {key: W, frames: 60}
  - expect: {player: true, translation.x: {greater: -1.0}}
  - expect: {gamestate: minimap_x, greater: 113}
