# Wolfenstein mini, the hits seen on screen with the visual scripts built as Play in Owl Nest builds them (probes of
# the wire values): the guard of the start room records where it fired from (guard.owlvs), status.owlvs flashes the
# view and glows on the side of the shot, and player.owlvs shakes the view, without a script error.
scene: ../../../samples/wolfenstein/scenes/level_1.owl
project: ../../../samples/wolfenstein
debug_scripts: true
steps:
  - frames: 40
  - expect: {gamestate: wolf_flashes, equals: 0}
  - expect: {gamestate: wolf_face, less: 5}
  - actions: {turn: 1, frames: 60}
  - actions: {fire: true, frames: 1}
  - frames: 120
  - expect: {gamestate: wolf_hurts, equals: 1}
  - expect: {gamestate: wolf_flashes, equals: 1}
  - expect: {gamestate: wolf_hit_side, equals: 1}
  - expect: {gamestate: wolf_low_health, equals: 0}
