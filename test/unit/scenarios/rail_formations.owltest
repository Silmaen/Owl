# Ring Runner: the two wingmen hold their slots beside the ship on their steering agents, and the fighters of the
# first squadron (a line) fly in the formation of their leader (foes.lua); shot down, the leader leaves its wing to
# scatter past the ship.
scene: ../../../samples/rail_shooter/scenes/level.owl
timestep_ms: 33.333
steps:
  - frames: 5
  - input: {mouse: Left, frames: 2}
  - frames: 3
  - expect: {gamestate: rail_phase, equals: play}
  - frames: 420
  - expect: {gamestate: rail_formed, greater: 1}
  - expect: {entity: Wingman, exists: true}
  - input: {mouse: Left, frames: 300}
  - expect: {gamestate: rail_kills, greater: 0}
