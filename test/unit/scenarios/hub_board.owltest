# The hub's information board: E next to the sign opens the window of help text, S scrolls its scroll view (the hero
# stands still), Escape closes it without pausing the game, E opens it again and closes it.
scene: ../../../engine_demo/scenes/world_map.owl
steps:
  - frames: 30
  - expect: {gamestate: board_open, equals: 0}
  # The sign stands four cells west of the start, at the entrance of the village.
  - input: {key: A, frames: 40}
  - input: {key: E, frames: 3}
  - frames: 5
  - expect: {gamestate: board_open, equals: 1}
  - expect: {gamestate: board_scroll, equals: 0}
  # The move keys scroll the board instead of moving the hero.
  - input: {key: S, frames: 40}
  - expect: {gamestate: board_scroll, greater: 100}
  - expect: {player: true, translation.x: {less: 30.0}}
  - input: {key: Escape, frames: 3}
  - frames: 10
  - expect: {gamestate: board_open, equals: 0}
  # Escape closed the window, it did not pause: the hub is still running.
  - expect: {entity: HouseDoorPlatform, exists: true}
  - input: {key: E, frames: 3}
  - frames: 5
  - expect: {gamestate: board_open, equals: 1}
  - input: {key: E, frames: 3}
  - frames: 5
  - expect: {gamestate: board_open, equals: 0}
