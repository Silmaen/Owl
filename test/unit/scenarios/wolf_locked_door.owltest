# Wolfenstein mini: the gold door of the start room of floor 1 stays closed without the key (locked_door.lua says so),
# the key lies behind the start, and with it the same door opens and lets the player through.
scene: ../../../samples/wolfenstein/scenes/level_1.owl
project: ../../../samples/wolfenstein
steps:
  - frames: 20
  - expect: {gamestate: wolf_key_gold, equals: 0}
  - actions: {walk: 1, frames: 150}
  - input: {key: E, frames: 3}
  - frames: 10
  - expect: {gamestate: wolf_locked_tries, equals: 1}
  - actions: {walk: 1, frames: 30}
  - expect: {player: true, translation.x: {less: -7.5}}
  # Back to the west wall, over the gold key.
  - actions: {walk: -1, frames: 150}
  - frames: 3
  - expect: {gamestate: wolf_key_gold, equals: 1}
  - actions: {walk: 1, frames: 150}
  - input: {key: E, frames: 3}
  - frames: 40
  - expect: {gamestate: wolf_doors_unlocked, equals: 1}
  - expect: {gamestate: wolf_locked_tries, equals: 1}
  - actions: {walk: 1, frames: 40}
  - expect: {player: true, translation.x: {greater: -6.5}}
