# Tower defence, Stonebridge: two gates, two roads meeting before the bridge. The first wave sends goblins down
# both roads (group letters a and b); with no tower they reach the keep and cost lives.
scene: ../../../samples/tower_defence/scenes/level_03.owl
steps:
  - frames: 30
  - expect: {gamestate: tower_roads, equals: 2}
  - input: {key: Space, frames: 2}
  - input: {key: F, frames: 2}
  - frames: 900
  - expect: {gamestate: tower_spawned, equals: 16}
  - expect: {gamestate: tower_spawned_b, equals: 8}
  - expect: {gamestate: tower_leaks, greater: 3}
