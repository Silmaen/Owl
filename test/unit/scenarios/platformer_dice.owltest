# The dice crates of the start fall the same way on every run and every target: the scene seed drives the throws.
scene: ../../../engine_demo/scenes/platformer_house.owl
steps:
  - frames: 240
  - expect: {gamestate: dice_total, equals: 71}
  - expect: {entity: DiceCrate1, translation.x: {equals: 1.4042280, tolerance: 0.001}}
  - expect: {entity: DiceCrate1, translation.y: {equals: -14.6, tolerance: 0.01}}
  - expect: {entity: DiceCrate2, translation.y: {equals: -14.6, tolerance: 0.01}}
  - expect: {entity: DiceCrate3, translation.y: {equals: -13.8, tolerance: 0.01}}
  - expect: {entity: DiceCrate4, translation.x: {equals: 3.3565166, tolerance: 0.001}}
