# The Moon Lantern, title and save slot: a new game starts in the cottage; the pause window (Escape) goes back to the
# title with the game saved, and Continue loads the save in the cottage again, the jar still in the bag.
scene: ../../../samples/point_and_click/scenes/title.owl
steps:
  - frames: 20
  - expect: {entity: NewButton, exists: true}
  - input: {key: Enter, frames: 2}
  - frames: 120
  - expect: {gamestate: room, equals: cottage}
  - input: {mouse: Left, mouse_pos: [291, 237], frames: 2}
  - frames: 300
  - expect: {gamestate: inventory_count, equals: 1}
  - input: {key: Escape, frames: 2}
  - frames: 3
  - expect: {gamestate: paused, equals: true}
  # Resume, Save, Title screen: the focus starts on Resume.
  - input: {key: Down, frames: 2}
  - frames: 3
  - input: {key: Down, frames: 2}
  - frames: 3
  - input: {key: Enter, frames: 2}
  - frames: 120
  - expect: {gamestate: title_has_save, equals: true}
  - input: {key: Down, frames: 2}
  - frames: 3
  - input: {key: Enter, frames: 2}
  - frames: 60
  - expect: {gamestate: room, equals: cottage}
  - expect: {gamestate: flag_jar_taken, equals: true}
  - expect: {gamestate: inventory, equals: jar}
