# The Sunken Shrine victory: the tally of the quest comes line by line and the best score is kept; Play again starts
# the quest in the hall.
scene: ../../../samples/sunken_shrine/scenes/victory.owl
steps:
  - frames: 10
  - expect: {entity: ScoreLabel, exists: true}
  - expect: {gamestate: shrine_tally, equals: true}
  - input: {key: Enter, frames: 2}
  - frames: 60
  - expect: {gamestate: shrine_room, equals: 1}
