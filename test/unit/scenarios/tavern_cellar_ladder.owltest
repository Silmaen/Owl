# The tavern cellar: aimed at, the ladder under the trapdoor climbs back to the tavern, where the player stands by the
# trapdoor instead of at the entrance.
scene: ../../../engine_demo/scenes/tavern_cellar.owl
project: ../../../engine_demo
steps:
  - frames: 60
  - expect: {entity: CellarPlayer, exists: true}
  - {command: entity.set_transform, args: {entity: CellarPlayer, translation: [2.9, 1.6, 2.2], rotation: [0, 3.1416, 0]}}
  - frames: 30
  - input: {key: E, frames: 3}
  - frames: 150
  - expect: {entity: TavernCamera, exists: true}
  - expect: {entity: TavernCamera, translation.x: {less: 2.4}}
  - expect: {entity: TavernCamera, translation.z: {less: 2.4}}
