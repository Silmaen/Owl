# Asteroid Field: the fighter has little translation inertia; full reverse throttle (away from the convoy) reaches its
# reverse speed within a second and a half, and the flight assist stops it within a second once the throttle is cut.
scene: ../../../samples/asteroid_field/scenes/mission.owl
steps:
  - frames: 10
  - input: {key: S, frames: 90}
  - expect: {gamestate: field_speed, greater: 22}
  - input: {key: Backspace, frames: 1}
  - frames: 60
  - expect: {gamestate: field_speed, less: 6}
