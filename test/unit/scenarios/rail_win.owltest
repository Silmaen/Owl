# Ring Runner won: the whole lane flown weaving from corner to corner with the lasers held (the weave dodges the aimed
# shots), the Warden destroyed, the end sequence, then the victory screen counts the stats up line by line and shows
# the medal; the best score is kept in the settings.
scene: ../../../samples/rail_shooter/scenes/level.owl
timestep_ms: 33.333
