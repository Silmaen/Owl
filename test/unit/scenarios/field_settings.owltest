# Asteroid Field settings: the music slider turned down with the D-pad, then across to the game and accessibility
# rows: the start without the flight assist on, the reduced motion on, the colour vision correction cycled; Back with
# pad B saves and returns to the title.
scene: ../../../samples/asteroid_field/scenes/settings.owl
steps:
  - frames: 10
  - expect: {setting: color_blind_mode, equals: none}
  - input: {gamepad: {button: DpadDown}, frames: 2}
  - frames: 1
  - input: {gamepad: {button: DpadLeft}, frames: 2}
  - frames: 1
  - input: {gamepad: {button: DpadLeft}, frames: 2}
  - frames: 1
  - expect: {setting: volume_music, less: 0.8}
  - input: {gamepad: {button: DpadDown}, frames: 2}
  - frames: 1
  - input: {gamepad: {button: DpadDown}, frames: 2}
  - frames: 1
  - input: {gamepad: {button: DpadDown}, frames: 2}
  - frames: 1
  - input: {gamepad: {button: DpadRight}, frames: 2}
  - frames: 1
  - expect: {gamestate: field_focus, equals: ToggleButton2}
  - input: {gamepad: {button: A}, frames: 2}
  - frames: 1
  - expect: {setting: field_no_assist, equals: true}
  - input: {gamepad: {button: DpadUp}, frames: 2}
  - frames: 1
  - input: {gamepad: {button: DpadUp}, frames: 2}
  - frames: 1
  - input: {gamepad: {button: DpadUp}, frames: 2}
  - frames: 1
  - input: {gamepad: {button: A}, frames: 2}
  - frames: 1
  - expect: {setting: reduced_motion, equals: true}
  - input: {gamepad: {button: DpadUp}, frames: 2}
  - frames: 1
  - input: {gamepad: {button: A}, frames: 2}
  - frames: 1
  - expect: {setting: color_blind_mode, equals: protanopia}
  - input: {gamepad: {button: B}, frames: 2}
  - frames: 60
  - expect: {entity: TitleArt, exists: true}
