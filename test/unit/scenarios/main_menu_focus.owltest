# The sample menus with actions only (a gamepad has the same `ui_*` actions): the Play button holds the focus from the
# start, `ui_down` reaches Settings, `ui_accept` opens it, the sliders answer `ui_down` / `ui_right`, `ui_cancel` goes back.
scene: ../../../engine_demo/scenes/main_menu.owl
steps:
  - frames: 10
  - expect: {entity: PlayButton, exists: true}
  - expect: {entity: MasterVolSlider, exists: false}
  - actions: {ui_down: true, frames: 1}
  - frames: 2
  - actions: {ui_accept: true, frames: 1}
  - frames: 90
  - expect: {entity: MasterVolSlider, exists: true}
  - expect: {entity: PlayButton, exists: false}
  - actions: {ui_down: true, frames: 1}
  - frames: 2
  - actions: {ui_right: true, frames: 30}
  - actions: {ui_left: true, frames: 5}
  - actions: {ui_cancel: true, frames: 1}
  - frames: 90
  - expect: {entity: PlayButton, exists: true}
  - expect: {entity: MasterVolSlider, exists: false}
