# Ring Runner lost: a ship that neither steers nor fires is worn down by the rocks and the squadrons, explodes and
# the game over screen counts its score up; Retry (Enter) flies the level again.
scene: ../../../samples/rail_shooter/scenes/level.owl
timestep_ms: 33.333
steps:
  - frames: 600
  - expect: {gamestate: rail_hull, less: 100}
  - frames: 900
  - expect: {gamestate: rail_lost, equals: true}
  - expect: {gamestate: rail_won, equals: false}
  - frames: 150
  - expect: {entity: ScoreLabel, exists: true}
  - expect: {entity: RetryButton, exists: true}
  - input: {key: Enter, frames: 2}
  - frames: 60
  - expect: {entity: RailCarrier, exists: true}
