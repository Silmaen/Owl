# The people of the tavern: the barkeeper holds his tankard on the `hand_r` socket of his skinned mesh (a socket of the
# Mesh Sockets component on the `arm-right` bone, above the bar), the server walks her spline between the bar and the
# tables.
scene: ../../../engine_demo/scenes/tavern.owl
steps:
  - input: {key: Space, frames: 2}
  - frames: 30
  - expect: {entity: Tankard, translation.y: {greater: 0.9}}
  - expect: {entity: Tankard, translation.y: {less: 1.3}}
  - expect: {entity: Tankard, translation.x: {less: 3.7}}
  - expect: {entity: Server, translation.z: {less: 0.0}}
  - frames: 120
  - expect: {entity: Server, translation.z: {greater: 0.3}}
  - expect: {entity: ServerWalker, translation.x: {less: 2.5}}
  - expect: {gamestate: tavern_dish, equals: A bowl of stew}
