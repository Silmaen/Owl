# Wolfenstein mini: the north wall of the start room of floor 1 hides a secret; turning to it and pressing E slides it
# (built-in `RaycastPushWall`) and secret.lua counts it once.
scene: ../../../samples/wolfenstein/scenes/level_1.owl
project: ../../../samples/wolfenstein
steps:
  - frames: 20
  - expect: {gamestate: wolf_secrets, equals: 0}
  - expect: {gamestate: wolf_secrets_total, equals: 3}
  # A quarter turn to the left (1.8 rad/s): from east to north.
  - actions: {turn: 1, frames: 52}
  - actions: {walk: 1, frames: 60}
  - input: {key: E, frames: 3}
  - frames: 30
  - expect: {gamestate: wolf_secrets, equals: 1}
  - frames: 120
  - expect: {gamestate: wolf_secrets, equals: 1}
  - expect: {gamestate: wolf_secrets_pct, equals: 33}
