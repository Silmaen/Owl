# Ring Runner title: the How to play window opens from its button (Down, Enter) and closes with Escape, then Launch
# (Up, Enter) plays the jingle and starts the level on its intro.
scene: ../../../samples/rail_shooter/scenes/title.owl
steps:
  - frames: 10
  - expect: {entity: TitleArt, exists: true}
  - expect: {gamestate: rail_how_to, equals: false}
  - input: {key: Down, frames: 2}
  - frames: 1
  - input: {key: Enter, frames: 2}
  - frames: 2
  - expect: {gamestate: rail_how_to, equals: true}
  - input: {key: Escape, frames: 2}
  - frames: 2
  - expect: {gamestate: rail_how_to, equals: false}
  - input: {key: Up, frames: 2}
  - frames: 1
  - input: {key: Enter, frames: 2}
  - frames: 90
  - expect: {entity: RailCarrier, exists: true}
  - expect: {gamestate: rail_phase, equals: intro}
