# A route through the start of the meadow: run, jump over the first pit with the coins above it, land before the spike.
scene: ../../../engine_demo/scenes/platformer_house.owl
steps:
  - frames: 30
  - input: {key: Right, frames: 69}
  - input: {keys: [Right, Space], frames: 5}
  - input: {key: Right, frames: 87}
  - frames: 30
  - expect: {player: true, translation.x: {greater: 17.0}}
  - expect: {player: true, translation.x: {less: 20.3}}
  - expect: {gamestate: health, equals: 1}
  - expect: {gamestate: score, greater: 29}
