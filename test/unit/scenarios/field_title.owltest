# Asteroid Field title: the How to play window opens from its button (Down, Enter) and closes with Escape, then Play
# (Up, Enter) plays the jingle and starts the mission.
scene: ../../../samples/asteroid_field/scenes/title.owl
steps:
  - frames: 10
  - expect: {entity: TitleArt, exists: true}
  - expect: {gamestate: field_how_to, equals: false}
  - input: {key: Down, frames: 2}
  - frames: 1
  - input: {key: Enter, frames: 2}
  - frames: 2
  - expect: {gamestate: field_how_to, equals: true}
  - input: {key: Escape, frames: 2}
  - frames: 2
  - expect: {gamestate: field_how_to, equals: false}
  - input: {key: Up, frames: 2}
  - frames: 1
  - input: {key: Enter, frames: 2}
  - frames: 90
  - expect: {entity: Player, exists: true}
  - expect: {gamestate: field_state, equals: fly}
