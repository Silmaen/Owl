FormatVersion: 1
VisualScript:
  variables:
    - {name: line_time, type: float, default: "0.55", min: 0.05}
    - {name: sweep_color, type: color, default: "0, 0.05, 0.14, 1"}
    - {name: MEDALS, type: numbers, default: "", exposed: false}
    - {name: lines, type: numbers, default: "", exposed: false}
    - {name: line_ids, type: numbers, default: "", exposed: false}
    - {name: medal_id, type: float, default: "0", exposed: false}
    - {name: best_id, type: float, default: "0", exposed: false}
    - {name: best_label, type: string, default: "", exposed: false}
    - {name: medal, type: float, default: "1", exposed: false}
    - {name: clock, type: float, default: "0", exposed: false}
    - {name: shown_line, type: float, default: "0", exposed: false}
    - {name: leaving, type: bool, default: "false", exposed: false}
    - {name: tmp_1, type: numbers, default: "", exposed: false}
    - {name: entry, type: float, default: "0", exposed: false}
    - {name: value, type: int, default: "0", exposed: false}
    - {name: number, type: string, default: "", exposed: false}
    - {name: current, type: float, default: "0", exposed: false}
    - {name: medal_clock, type: float, default: "0", exposed: false}
    - {name: t, type: float, default: "0", exposed: false}
    - {name: size, type: float, default: "0", exposed: false}
  functions:
    - name: line
      inputs: [{name: label, type: any}, {name: value, type: any}, {name: format, type: any}, {name: suffix, type: any}]
      outputs: []
      exported: true
    - name: write
      inputs: [{name: index, type: any}, {name: fraction, type: any}]
      outputs: []
    - name: leave
      inputs: [{name: path, type: any}]
      outputs: []
  customNodes:
    - name: init_state
      title: Init State
      inputs: []
      outputs: []
      code: |
        MEDALS = { "BRONZE", "SILVER", "GOLD" }
        lines = {}
        line_ids = {}
    - name: do_on_create
      title: On create
      inputs: []
      outputs: []
      code: |
        if not ui.is_transition_active() then ui.transition_play("fade", 0.8, 0.9, 0.95, 1.0) end
        sound.play("sounds/ui/victory.wav")
        local score = gamestate.get("rail_result_score", 0)
        medal = gamestate.get("rail_result_medal", 1)
        line("SCORE", score, "%06d")
        line("HULL BONUS", gamestate.get("rail_result_bonus", 0))
        line("ENEMIES DOWN", gamestate.get("rail_result_kills", 0), "%d", " / " .. gamestate.get("rail_result_foes", 0))
        line("ROCKS BROKEN", gamestate.get("rail_result_rocks", 0))
        line("HIT RATIO", gamestate.get("rail_result_hits", 0), "%d", "%")
        line("HULL LEFT", gamestate.get("rail_result_hull", 0), "%d", "%")
        for index = 1, #lines do line_ids[index] = scene.find_entity("StatLine" .. index) end
        medal_id = scene.find_entity("Medal")
        best_id = scene.find_entity("BestLabel")
        if medal_id ~= 0 then
            ui.set_image_frame(medal_id, medal)
            ui.set_visible(medal_id, false)
        end
        local best = settings.get("rail_best", 0)
        local best_text = string.format("BEST %06d", best)
        if score > best then
            settings.set("rail_best", score)
            best_text = "NEW BEST SCORE!"
        end
        if medal > settings.get("rail_best_medal", 0) then settings.set("rail_best_medal", medal) end
        settings.save()
        if best_id ~= 0 then ui.set_text(best_id, "") end
        best_label = best_text
        gamestate.set("rail_tally_done", false)
