      inputs: [{name: value, type: any}]
      outputs: [{name: result, type: any}]
    - name: refresh
      inputs: []
      outputs: []
    - name: set_volume
      inputs: [{name: setting, type: any}]
      outputs: []
    - name: go_back
      inputs: []
      outputs: []
      exported: true
  customNodes:
