FormatVersion: 1
VisualScript:
  variables:
    - {name: count_time, type: float, default: "1", min: 0.01}
    - {name: sweep_color, type: color, default: "0, 0.05, 0.14, 1"}
    - {name: score, type: float, default: "0", exposed: false}
    - {name: shown, type: float, default: "-1", exposed: false}
    - {name: clock, type: float, default: "0", exposed: false}
    - {name: score_id, type: entity, default: "0", exposed: false}
    - {name: leaving, type: bool, default: "false", exposed: false}
    - {name: best, type: float, default: "0", exposed: false}
    - {name: best_text, type: string, default: "", exposed: false}
    - {name: best_id, type: entity, default: "0", exposed: false}
    - {name: distance_id, type: entity, default: "0", exposed: false}
    - {name: value, type: int, default: "0", exposed: false}
  functions:
    - name: leave
      inputs: [{name: path, type: any}]
      outputs: []
