FormatVersion: 1
VisualScript:
  variables:
    - {name: bridge_scene, type: string, default: scenes/bridge.owl}
    - {name: cottage_scene, type: string, default: scenes/cottage.owl}
    - {name: hotspots, type: strings, default: "fireflies use, bush pick, mushrooms look, pond look, to_cottage exit cottage_scene, to_bridge exit bridge_scene"}
    - {name: adventure, type: float, default: "0", exposed: false}
    - {name: ids, type: numbers, default: "", exposed: false}
    - {name: clock, type: float, default: "0", exposed: false}
  functions:
    - name: refresh
      inputs: []
      outputs: []
      exported: true
    - name: act
      inputs: [{name: id, type: any}, {name: verb, type: any}, {name: item, type: any}]
      outputs: [{name: result, type: any}]
      exported: true
  customNodes:
    - name: init_state
      title: Init State
      inputs: []
      outputs: []
      code: |
        adventure = nil
        ids = {}
    - name: do_act
      title: Act
      inputs: [{name: id, type: any}, {name: verb, type: any}, {name: item, type: any}]
      outputs: [{name: r1, type: any}]
      code: |
        if id == "bush" and verb ~= "look" then
            if item ~= nil then
                adventure.say("say.glade.bush_item")
            elseif adventure.flag("berries_taken") then
                adventure.say("say.glade.bush_empty")
            else
                adventure.act_animation(function()
                    adventure.set_flag("berries_taken")
                    adventure.give("berries")
                    refresh()
                    adventure.say("say.glade.berries")
                end)
            end
            return true
        end
        if id == "fireflies" and verb ~= "look" then
            if item == "jar" then
                adventure.act_animation(function()
                    adventure.take("jar")
                    adventure.give("firefly_jar")
                    sound.play("sounds/fireflies.wav")
                    ui.show_subtitle(tr("subtitle.fireflies"), 2)
                    adventure.say("say.glade.fireflies_caught")
                end, 0.9)
            elseif item == "firefly_jar" then
                adventure.say("say.glade.fireflies_enough")
            elseif item ~= nil then
                adventure.say("say.glade.fireflies_item")
            else
                adventure.say("say.glade.fireflies_hands")
            end
            return true
        end
        if id == "mushrooms" and verb ~= "look" then
            adventure.say("say.glade.mushrooms_touch")
            return true
        end
        return false
    - name: do_on_create
      title: On create
      inputs: []
      outputs: []
      code: |
        adventure = require("scripts.game.adventure")
        ids.berries = scene.find_entity("Prop_berries")
        ids.fireflies = scene.find_entity("Prop_fireflies")
        adventure.start({ name = "glade", hotspots = hotspots, act = act, highlights = { bush = "Prop_berries" } })
        refresh()
  nodes:
    - id: 1362900001
      type: func.entry
      position: [340, 0]
      values:
        function: refresh
    - id: 1362900002
      type: call.ui.set_visible
      position: [680, 0]
    - id: 1362900003
      type: var.get
      position: [510, 160]
      values:
        variable: ids
    - id: 1362900004
      type: table.get
