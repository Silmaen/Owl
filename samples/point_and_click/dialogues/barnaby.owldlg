  - id: 9500000000000000003
    kind: Choice
    position: [520, 120]
    speaker: {text: 'Barnaby', key: dialogue.barnaby.name}
    text: {text: 'What troubles you, my boy?', key: dialogue.barnaby.ask}
    options:
      - text: {text: 'Where is its moonstone?', key: dialogue.barnaby.answer_stone}
        next: 9500000000000000004
      - text: {text: 'What else does it need?', key: dialogue.barnaby.answer_help}
        next: 9500000000000000006
