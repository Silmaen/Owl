  - id: 9500000000000000008
    kind: Line
    position: [1340, 240]
    speaker: {text: 'Barnaby', key: dialogue.barnaby.name}
    text: {text: 'A moonstone sleeps without a spark. Fireflies make lovely sparks, if you can keep them in something.', key: dialogue.barnaby.spark}
    next: 9500000000000000003
  - id: 9500000000000000009
    kind: Line
    position: [820, 400]
    speaker: {text: 'Barnaby', key: dialogue.barnaby.name}
    text: {text: 'Mind the troll''s manners. And yours.', key: dialogue.barnaby.bye}
