    position: [1080, 0]
    speaker: {text: 'Barnaby', key: dialogue.barnaby.name}
    text: {text: 'The bridge troll took it. He sits on everything shiny. And he has a terrible sweet tooth.', key: dialogue.barnaby.stone}
