  - Entity: 7300000030968000029
    Tag:
      tag: HowToControls
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 7300000030968000026
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [0.94, 0.4]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiText:
      outlineWidth: 2
      text: "MAIN ENGINE   Space, left click, RT (or A)\nTILT          W A S D, left stick\nSIDE JETS     arrows, d-pad\nTURN VIEW     Q / E, R / F, right drag, right stick\nZOOM          Z / X, wheel, LB / RB\nPAUSE         Escape, P, Start"
      color: [1, 0.72, 0.25, 1]
      fontSize: 21
      horizontalAlignment: Left
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0.25
      wrap: true
      fit: Shrink
      minFontSize: 12
      font: JetBrainsMono-Regular
  - Entity: 7300000030968000030
    Tag:
      tag: HowToRules
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 7300000030968000026
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [0.94, 0.36]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiText:
      outlineWidth: 2
      text: 'Bring the lander down on the lit pad, gently and upright. The main engine pushes along the lander, so tilt it to steer; the side jets slide it a little. The beads show where you are going and the red cross where you would hit the ground. Land too hard and a leg snaps; touch the ground with the hull, miss the pad or run dry in the air and the landing is lost. Five landings, from a hover to a descent from orbit: fuel left, precision and a soft touchdown make the score.'
      color: [0.7, 0.75, 0.85, 1]
      fontSize: 22
      horizontalAlignment: Left
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0.2
      wrap: true
      fit: Shrink
      minFontSize: 12
