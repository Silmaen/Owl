FormatVersion: 1
VisualScript:
  variables:
    - {name: landing, type: int, default: 1}
    - {name: this_scene, type: string, default: scenes/landing_1.owl}
    - {name: next_scene, type: string, default: scenes/landing_2.owl}
    - {name: pad_tag, type: string, default: Pad1}
    - {name: pad_name, type: string, default: TRANQUILITY BASE}
    - {name: fuel_max, type: float, default: 50, min: 1}
    - {name: start_velocity, type: vec3, default: '0, 0, 0'}
    - {name: thrust, type: float, default: 3.4, min: 0}
    - {name: turn_rate, type: float, default: 1.1, min: 0}
    - {name: rcs, type: float, default: 0.8, min: 0}
    - {name: burn_rate, type: float, default: 4, min: 0}
    - {name: chase_distance, type: float, default: 13, min: 2}
    - {name: beads, type: int, default: 24, min: 0}
    - {name: landings, type: int, default: 5, min: 1}
    - {name: state, type: string, default: fly, exposed: false}
    - {name: fuel, type: float, default: 0, exposed: false}
    - {name: throttle, type: float, default: 0, exposed: false}
    - {name: clock, type: float, default: 0, exposed: false}
    - {name: rest, type: float, default: 0, exposed: false}
    - {name: touchdown, type: float, default: -1, exposed: false}
    - {name: engine_clock, type: float, default: 0, exposed: false}
    - {name: warned, type: bool, default: false, exposed: false}
    - {name: paused, type: bool, default: false, exposed: false}
    - {name: leaving, type: bool, default: false, exposed: false}
    - {name: message_time, type: float, default: 0, exposed: false}
  functions:
    - name: check_flight
      inputs: [{name: altitude, type: number}, {name: ground, type: entity}]
      outputs: []
    - name: check_end
      inputs: [{name: dt, type: number}]
      outputs: []
    - name: win
      inputs: []
      outputs: []
    - name: lose
      inputs: [{name: reason, type: string}, {name: sound, type: string}]
      outputs: []
    - name: say
      inputs: [{name: text, type: string}]
      outputs: []
    - name: set_paused
      inputs: [{name: paused, type: boolean}]
      outputs: []
  nodes:
    - id: 6400000000000000001
      type: event.on_create
      position: [0, 0]
    - id: 6400000000000000002
      type: call.ui.is_transition_active
      position: [-60, 300]
