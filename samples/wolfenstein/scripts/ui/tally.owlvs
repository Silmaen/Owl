FormatVersion: 1
VisualScript:
  variables:
    - {name: fade_color, type: color, default: "0.22, 0.02, 0.02, 1"}
    - {name: line_pause, type: float, default: "0.35", min: 0}
    - {name: LINES, type: numbers, default: "", exposed: false}
    - {name: COUNT_RATE, type: numbers, default: "", exposed: false}
    - {name: TICK_EVERY, type: numbers, default: "", exposed: false}
    - {name: ids, type: numbers, default: "", exposed: false}
