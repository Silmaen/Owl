    - {name: tmp_3, type: float, default: "0", exposed: false}
    - {name: tmp_4, type: float, default: "0", exposed: false}
  functions:
    - name: format
      inputs: [{name: entry, type: any}, {name: value, type: any}]
      outputs: [{name: result, type: any}]
    - name: set
      inputs: [{name: name, type: any}, {name: text, type: any}]
      outputs: []
    - name: finish_line
      inputs: [{name: entry, type: any}]
      outputs: []
    - name: show_scores
      inputs: []
      outputs: []
    - name: skip
      inputs: []
      outputs: []
  customNodes:
    - name: init_state
      title: Init State
      inputs: []
      outputs: []
      code: |
        LINES = {
            { id = "ItemsLabel", name = "ITEMS", key = "wolf_tally_items", unit = "%" },
            { id = "SecretsLabel", name = "SECRETS", key = "wolf_tally_secrets", unit = "%" },
            { id = "MapLabel", name = "MAP EXPLORED", key = "wolf_tally_explored", unit = "%" },
            { id = "BonusLabel", name = "BONUS", key = "wolf_tally_bonus", unit = "" },
        }
        COUNT_RATE = { ["%"] = 80, [""] = 2400 }
        TICK_EVERY = { ["%"] = 5, [""] = 150 }
        ids = {}
