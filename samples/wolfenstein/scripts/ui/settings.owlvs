FormatVersion: 1
VisualScript:
  variables:
    - {name: ui_scale_min, type: float, default: "0.75", min: 0.1}
    - {name: ui_scale_max, type: float, default: "2", min: 0.1}
    - {name: sensitivity_min, type: float, default: "0.25", min: 0.01}
    - {name: sensitivity_max, type: float, default: "3", min: 0.01}
    - {name: VOLUMES, type: numbers, default: "", exposed: false}
    - {name: COLOR_BLIND_MODES, type: numbers, default: "", exposed: false}
    - {name: COLOR_BLIND_NAMES, type: numbers, default: "", exposed: false}
    - {name: RESET_KEYS, type: numbers, default: "", exposed: false}
    - {name: ids, type: numbers, default: "", exposed: false}
    - {name: leaving, type: bool, default: "false", exposed: false}
    - {name: mode, type: float, default: "0", exposed: false}
    - {name: current, type: float, default: "0", exposed: false}
    - {name: next_mode, type: float, default: "0", exposed: false}
    - {name: shown, type: bool, default: "false", exposed: false}
  functions:
    - name: percent
      inputs: [{name: value, type: any}]
      outputs: [{name: result, type: any}]
    - name: on_off
      inputs: [{name: value, type: any}]
      outputs: [{name: result, type: any}]
    - name: update_labels
      inputs: []
      outputs: []
    - name: update_sliders
      inputs: []
      outputs: []
    - name: set_volume
      inputs: [{name: setting, type: any}]
      outputs: []
    - name: go_back
      inputs: []
      outputs: []
      exported: true
  customNodes:
    - name: init_state
      title: Init State
      inputs: []
      outputs: []
      code: |
        VOLUMES = {
            { setting = "volume_master", slider = "MasterVolSlider", label = "MasterVolLabel", text = "Master volume" },
            { setting = "volume_music", slider = "MusicVolSlider", label = "MusicVolLabel", text = "Music" },
            { setting = "volume_sfx", slider = "SfxVolSlider", label = "SfxVolLabel", text = "Effects" },
        }
        COLOR_BLIND_MODES = { "none", "protanopia", "deuteranopia", "tritanopia" }
        COLOR_BLIND_NAMES = { none = "STANDARD", protanopia = "PROTANOPIA", deuteranopia = "DEUTERANOPIA",
                                    tritanopia = "TRITANOPIA" }
        RESET_KEYS = { "volume_master", "volume_music", "volume_sfx", "volume_ambient", "mouse_sensitivity", "ui_scale",
                             "color_blind_mode", "reduced_motion", "subtitles" }
        ids = {}
