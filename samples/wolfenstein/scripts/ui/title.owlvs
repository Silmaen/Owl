FormatVersion: 1
VisualScript:
  variables:
    - {name: fade_color, type: color, default: "0.22, 0.02, 0.02, 1"}
    - {name: FLOORS, type: float, default: "3", exposed: false}
    - {name: pending_slot, type: float, default: "0", exposed: false}
    - {name: leaving, type: bool, default: "false", exposed: false}
    - {name: window_id, type: float, default: "0", exposed: false}
    - {name: back_id, type: float, default: "0", exposed: false}
    - {name: how_to_id, type: float, default: "0", exposed: false}
    - {name: slot, type: float, default: "0", exposed: false}
    - {name: stamp, type: string, default: "", exposed: false}
    - {name: tmp_1, type: float, default: "0", exposed: false}
    - {name: tmp_2, type: float, default: "0", exposed: false}
    - {name: on_continue_clicked_slot, type: float, default: "0", exposed: false}
  functions:
    - name: newest_slot
      inputs: []
      outputs: [{name: result, type: any}]
      exported: true
    - name: leave
      inputs: [{name: path, type: any}, {name: jingle, type: any}]
      outputs: []
    - name: on_how_to_closed
      inputs: []
      outputs: []
      exported: true
  customNodes:
    - name: do_on_create
      title: On create
      inputs: []
      outputs: []
      code: |
        if not ui.is_transition_active() then
            ui.transition_play("fade_in", 0.6, fade_color.r, fade_color.g, fade_color.b)
        end
        window_id = scene.find_entity("HowToWindow")
        back_id = scene.find_entity("HowToBackButton")
        how_to_id = scene.find_entity("HowToButton")
        local continue_id = scene.find_entity("ContinueButton")
        if continue_id ~= 0 then
            ui.set_button_enabled(continue_id, newest_slot() ~= 0)
        end
        local lines = { string.format("BEST SCORE  %d", settings.get("wolf_best_score", 0)) }
        for floor = 1, FLOORS do
            local best = "wolf_best_" .. floor .. "_"
            lines[#lines + 1] = string.format("FLOOR %d\n  items %d%%  secrets %d%%  map %d%%", floor,
                    settings.get(best .. "items", 0), settings.get(best .. "secrets", 0), settings.get(best .. "explored", 0))
        end
        local best_id = scene.find_entity("BestText")
        if best_id ~= 0 then
            ui.set_text(best_id, table.concat(lines, "\n"))
        end
