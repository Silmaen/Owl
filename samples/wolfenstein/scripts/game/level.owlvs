FormatVersion: 1
VisualScript:
  variables:
    - {name: level, type: int, default: "1"}
    - {name: title, type: string, default: Floor 1}
    - {name: fade_color, type: color, default: "0.22, 0.02, 0.02, 1"}
    - {name: toast_seconds, type: float, default: "2.5", min: 0}
    - {name: ITEM_TAGS, type: numbers, default: "", exposed: false}
    - {name: AUTOSAVE_SLOT, type: float, default: "1", exposed: false}
    - {name: QUICK_SLOT, type: float, default: "2", exposed: false}
    - {name: ids, type: numbers, default: "", exposed: false}
    - {name: shown, type: numbers, default: "", exposed: false}
    - {name: toast_left, type: float, default: "0", exposed: false}
    - {name: autosave, type: bool, default: "false", exposed: false}
    - {name: leaving, type: bool, default: "false", exposed: false}
