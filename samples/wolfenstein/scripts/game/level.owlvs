    - {name: has, type: bool, default: "false", exposed: false}
    - {name: message, type: float, default: "0", exposed: false}
  functions:
    - name: set_text
      inputs: [{name: name, type: any}, {name: text, type: any}]
      outputs: []
    - name: ratio
      inputs: [{name: found, type: any}, {name: total, type: any}]
      outputs: [{name: result, type: any}]
    - name: start_floor
      inputs: []
      outputs: []
    - name: set_paused
      inputs: [{name: value, type: any}]
      outputs: []
    - name: refresh_hud
      inputs: []
      outputs: []
    - name: toast
      inputs: [{name: text, type: any}]
      outputs: []
  customNodes:
    - name: init_state
      title: Init State
      inputs: []
      outputs: []
      code: |
        ITEM_TAGS = { "Cross", "Chalice", "Chest", "Crown", "Food", "DogFood", "GoldKey", "BlueKey" }
        ids = {}
        shown = {}
