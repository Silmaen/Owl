FormatVersion: 1
VisualScript:
  variables:
    - {name: save_period, type: float, default: "0.5"}
    - {name: hearing, type: int, default: "12"}
    - {name: fog_rays, type: int, default: "41", min: 2}
    - {name: fog_fov, type: float, default: "80", min: 10, max: 170}
    - {name: fog_range, type: float, default: "14", min: 1}
    - {name: fog_rows_per_frame, type: int, default: "8", min: 1}
    - {name: MAP_SIZE, type: float, default: "32", exposed: false}
    - {name: WALL_LAYER, type: float, default: "0", exposed: false}
    - {name: SEEN_LAYER, type: float, default: "1", exposed: false}
    - {name: TILE_WALL, type: float, default: "0", exposed: false}
    - {name: TILE_FLOOR, type: float, default: "1", exposed: false}
    - {name: SAVE_PERIOD, type: float, default: "0", exposed: false}
    - {name: HEARING, type: int, default: "0", exposed: false}
    - {name: SMALL, type: numbers, default: "", exposed: false}
    - {name: LARGE, type: numbers, default: "", exposed: false}
    - {name: DOOR_TAGS, type: numbers, default: "", exposed: false}
    - {name: MARKER_TAGS, type: numbers, default: "", exposed: false}
    - {name: player_id, type: entity, default: "0", exposed: false}
    - {name: dot_id, type: entity, default: "0", exposed: false}
    - {name: facing_id, type: entity, default: "0", exposed: false}
    - {name: view, type: numbers, default: "", exposed: false}
    - {name: solid, type: numbers, default: "", exposed: false}
    - {name: blockers, type: numbers, default: "", exposed: false}
    - {name: doors, type: numbers, default: "", exposed: false}
    - {name: secrets, type: numbers, default: "", exposed: false}
    - {name: seen, type: numbers, default: "", exposed: false}
    - {name: bits, type: numbers, default: "", exposed: false}
    - {name: floor_total, type: float, default: "0", exposed: false}
    - {name: floor_seen, type: float, default: "0", exposed: false}
    - {name: dirty, type: bool, default: "false", exposed: false}
    - {name: save_clock, type: float, default: "0", exposed: false}
    - {name: fog_row, type: float, default: "0", exposed: false}
    - {name: markers, type: numbers, default: "", exposed: false}
    - {name: markers_shown, type: float, default: "0", exposed: false}
    - {name: markers_hidden, type: bool, default: "false", exposed: false}
    - {name: blocker, type: float, default: "0", exposed: false}
    - {name: key, type: float, default: "0", exposed: false}
    - {name: tmp_1, type: float, default: "0", exposed: false}
    - {name: wall, type: float, default: "0", exposed: false}
    - {name: reveal_key, type: float, default: "0", exposed: false}
    - {name: dx, type: float, default: "0", exposed: false}
    - {name: dy, type: float, default: "0", exposed: false}
    - {name: c, type: float, default: "0", exposed: false}
    - {name: r, type: float, default: "0", exposed: false}
    - {name: step_c, type: int, default: "0", exposed: false}
    - {name: step_r, type: int, default: "0", exposed: false}
    - {name: delta_c, type: float, default: "0", exposed: false}
    - {name: delta_r, type: float, default: "0", exposed: false}
    - {name: side_c, type: float, default: "0", exposed: false}
    - {name: side_r, type: float, default: "0", exposed: false}
    - {name: distance, type: float, default: "0", exposed: false}
    - {name: cast_key, type: float, default: "0", exposed: false}
    - {name: last, type: float, default: "0", exposed: false}
    - {name: setup_fog_rows_key, type: float, default: "0", exposed: false}
    - {name: tmp_2, type: numbers, default: "", exposed: false}
    - {name: tmp_3, type: numbers, default: "", exposed: false}
    - {name: px, type: float, default: "0", exposed: false}
    - {name: py, type: float, default: "0", exposed: false}
    - {name: x, type: float, default: "0", exposed: false}
    - {name: y, type: float, default: "0", exposed: false}
    - {name: near, type: float, default: "0", exposed: false}
    - {name: settle_x, type: float, default: "0", exposed: false}
    - {name: settle_y, type: float, default: "0", exposed: false}
    - {name: settle_c, type: float, default: "0", exposed: false}
    - {name: settle_r, type: float, default: "0", exposed: false}
    - {name: settle_key, type: float, default: "0", exposed: false}
  functions:
    - name: cell_of
      inputs: [{name: x, type: any}, {name: y, type: any}, {name: _z, type: any}]
      outputs: [{name: result, type: any}, {name: result_2, type: any}]
      exported: true
    - name: key_of
      inputs: [{name: c, type: any}, {name: r, type: any}]
      outputs: [{name: result, type: any}]
      exported: true
    - name: closed
      inputs: [{name: key, type: any}]
      outputs: [{name: result, type: any}]
      exported: true
    - name: show
      inputs: [{name: c, type: any}, {name: r, type: any}]
      outputs: []
      exported: true
    - name: mark
      inputs: [{name: key, type: any}]
      outputs: []
      exported: true
    - name: reveal
      inputs: [{name: c, type: any}, {name: r, type: any}]
      outputs: []
      exported: true
    - name: cast
      inputs: [{name: px, type: any}, {name: py, type: any}, {name: angle, type: any}]
      outputs: []
      exported: true
    - name: percent
      inputs: []
      outputs: [{name: result, type: any}]
      exported: true
    - name: setup_fog_rows
      inputs: []
      outputs: [{name: result, type: any}]
      exported: true
    - name: place
      inputs: [{name: scale, type: any}, {name: x, type: any}, {name: y, type: any}]
      outputs: []
      exported: true
    - name: play_near
      inputs: [{name: path, type: any}, {name: id, type: any}]
      outputs: []
      exported: true
    - name: settle
      inputs: [{name: d, type: any}]
      outputs: []
      exported: true
  customNodes:
    - name: init_state
      title: Init State
      inputs: []
      outputs: []
      code: |
        SAVE_PERIOD = nil
        HEARING = nil
        SMALL = { scale = 5, x = 96, y = 211 }
        LARGE = { scale = 11, x = 192, y = 307 }
        DOOR_TAGS = { "Door", "GoldDoor", "BlueDoor", "ElevatorDoor" }
        MARKER_TAGS = { "GoldKey", "BlueKey", "ExitElevator" }
        view = SMALL
        solid = {}
        blockers = {}
        doors = {}
        secrets = {}
        seen = {}
        bits = {}
        markers = {}
    - name: update_fog
      title: Update fog
      inputs: [{name: dt, type: any}]
      outputs: []
      code: |
        local px, py = transform.get_position(player_id)
        local _, _, yaw = transform.get_rotation(player_id)
        local tx, ty = px + MAP_SIZE / 2, MAP_SIZE / 2 - py
        local c, r = math.floor(tx), math.floor(ty)
        for dr = -1, 1 do
            for dc = -1, 1 do
                reveal(c + dc, r + dr)
            end
        end
        for i = 0, fog_rays - 1 do
            cast(tx, ty, yaw + (i / (fog_rays - 1) - 0.5) * math.rad(fog_fov))
        end
        gamestate.set("wolf_seen", floor_seen)
        gamestate.set("wolf_explored", percent())
        save_clock = save_clock + dt
        if dirty and save_clock >= SAVE_PERIOD then
            dirty = false
            save_clock = 0
            gamestate.set("wolf_seen_map", table.concat(bits))
        end
    - name: restore_seen
      title: Restore seen
      inputs: []
      outputs: []
      code: |
        local saved = gamestate.get("wolf_seen_map", "")
        for key = 0, MAP_SIZE * MAP_SIZE - 1 do
            if saved:byte(key + 1) == 49 then
                mark(key)
                show(key % MAP_SIZE, key // MAP_SIZE)
            end
        end
    - name: add_blocker
      title: Add blocker
      inputs: [{name: list, type: any}, {name: id, type: any}, {name: state, type: any}]
      outputs: []
      code: |
        local x, y = transform.get_position(id)
        local c, r = cell_of(x, y)
        local blocker = { closed = state == "idle" }
        blockers[key_of(c, r)] = blocker
        list[#list + 1] = { id = id, state = state, blocker = blocker, c = c, r = r }
    - name: update_markers
      title: Update markers
      inputs: []
      outputs: []
      code: |
        if gamestate.get("wolf_leaving", 0) == 1 then
            if not markers_hidden then
                markers_hidden = true
                for _, m in ipairs(markers) do
                    if m.shown and entity.has_component(m.id, "HudMarker") then
                        entity.set_hud_marker_enabled(m.id, false)
                    end
                end
            end
            return
        end
        for _, m in ipairs(markers) do
            if not m.shown and entity.has_component(m.id, "HudMarker")
                    and seen[key_of(cell_of(transform.get_position(m.id)))] then
                m.shown = true
                entity.set_hud_marker_enabled(m.id, true)
                markers_shown = markers_shown + 1
                gamestate.set("wolf_markers", markers_shown)
            end
        end
    - name: follow
      title: Follow
      inputs: [{name: list, type: any}, {name: state_of, type: any}]
      outputs: []
      code: |
        for _, d in ipairs(list) do
            local state = state_of(d.id)
            if state ~= d.state then
                if state == "opening" and list == doors and player_id ~= 0 then
                    play_near("sounds/game/door.wav", d.id)
                    gamestate.set("wolf_doors_opened", gamestate.get("wolf_doors_opened", 0) + 1)
                end
                d.blocker.closed = state == "idle"
                if seen[key_of(d.c, d.r)] then
                    show(d.c, d.r)
                end
                if state == "final" and list == secrets then
                    settle(d)
                end
                d.state = state
            end
        end
    - name: do_on_update
      title: On update
      inputs: [{name: dt, type: any}]
      outputs: []
      code: |
        follow(doors, door.get_state)
        follow(secrets, pushwall.get_state)
        if fog_row < MAP_SIZE then
            if setup_fog_rows() then
                restore_seen()
            end
            return
        end
        if player_id == 0 then
            return
        end
        update_fog(dt)
        update_markers()

        if input.is_action_just_pressed("map") then
            local next_view = view.scale == SMALL.scale and LARGE or SMALL
            place(next_view.scale, next_view.x, next_view.y)
            gamestate.set("wolf_large_map", view.scale == LARGE.scale and 1 or 0)
        end
        local px, py = transform.get_position(player_id)
        -- Clamped to the map so that a player pushed outside never leaves it.
        local cx = math.max(-MAP_SIZE / 2, math.min(MAP_SIZE / 2, px)) * view.scale
        local cy = math.max(-MAP_SIZE / 2, math.min(MAP_SIZE / 2, py)) * view.scale
        transform.set_position(dot_id, view.x + cx, view.y + cy, 0.1)
        local _, _, yaw = transform.get_rotation(player_id)
        local offset = view.scale * 1.4
        transform.set_position(facing_id, view.x + cx - math.sin(yaw) * offset, view.y + cy + math.cos(yaw) * offset, 0.2)
