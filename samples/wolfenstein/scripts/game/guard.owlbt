FormatVersion: 1
BehaviourTree:
  blackboard:
    - name: damage
      type: Number
      value: 0
      description: "Damage taken since the last frame, added by the shots of the player."
    - name: dead
      type: Bool
      value: false
      description: "Set by the graph when the health runs out."
