FormatVersion: 1
VisualScript:
  variables:
    - {name: floor_scene, type: string, default: scenes/level_1.owl}
    - {name: knife_range, type: float, default: "1.3", min: 0}
    - {name: gun_range, type: float, default: "24", min: 0}
    - {name: aim_cone, type: float, default: "0.1", min: 0}
    - {name: start_health, type: int, default: "100", min: 1}
    - {name: start_ammo, type: int, default: "8", min: 0}
    - {name: max_ammo, type: int, default: "99", min: 1}
    - {name: respawn_delay, type: float, default: "2.5", min: 0}
    - {name: fade_color, type: color, default: "0.45, 0, 0, 1"}
    - {name: tactics, type: numbers, default: "", exposed: false}
    - {name: DAMAGE, type: numbers, default: "", exposed: false}
    - {name: RATE, type: numbers, default: "", exposed: false}
    - {name: AUTOMATIC, type: numbers, default: "", exposed: false}
    - {name: SOUNDS, type: numbers, default: "", exposed: false}
    - {name: NAMES, type: numbers, default: "", exposed: false}
    - {name: AUTOSAVE_SLOT, type: float, default: "1", exposed: false}
    - {name: player_id, type: entity, default: "0", exposed: false}
    - {name: ids, type: numbers, default: "", exposed: false}
    - {name: shown, type: numbers, default: "", exposed: false}
    - {name: cooldown, type: float, default: "0", exposed: false}
    - {name: swing, type: float, default: "0", exposed: false}
    - {name: dead_clock, type: float, default: "0", exposed: false}
    - {name: dead, type: bool, default: "false", exposed: false}
    - {name: weapon, type: float, default: "0", exposed: false}
    - {name: next_weapon, type: float, default: "0", exposed: false}
    - {name: tmp_1, type: bool, default: "false", exposed: false}
    - {name: px, type: float, default: "0", exposed: false}
    - {name: py, type: float, default: "0", exposed: false}
    - {name: yaw, type: float, default: "0", exposed: false}
    - {name: range, type: float, default: "0", exposed: false}
    - {name: target, type: entity, default: "0", exposed: false}
    - {name: distance, type: float, default: "0", exposed: false}
    - {name: phase, type: float, default: "0", exposed: false}
    - {name: length, type: float, default: "0", exposed: false}
    - {name: frame, type: float, default: "0", exposed: false}
    - {name: health, type: float, default: "0", exposed: false}
    - {name: on_update_weapon, type: float, default: "0", exposed: false}
    - {name: damage, type: float, default: "0", exposed: false}
    - {name: wants, type: bool, default: "false", exposed: false}
  functions:
    - name: set_text
      inputs: [{name: name, type: any}, {name: text, type: any}]
      outputs: []
    - name: owns
      inputs: [{name: weapon, type: any}]
      outputs: [{name: result, type: any}]
    - name: reset
      inputs: []
      outputs: []
    - name: select_weapon
      inputs: [{name: weapon, type: any}]
      outputs: []
    - name: cycle_weapon
      inputs: []
      outputs: []
    - name: attack
      inputs: [{name: weapon, type: any}]
      outputs: []
    - name: die
      inputs: []
      outputs: []
    - name: update_view
      inputs: [{name: weapon, type: any}, {name: dt, type: any}]
      outputs: []
  customNodes:
    - name: init_state
      title: Init State
      inputs: []
      outputs: []
      code: |
        tactics = require("scripts.game.tactics")
        DAMAGE = { 35, 30, 22, 22 }
        RATE = { 0.45, 0.4, 0.14, 0.08 }
        AUTOMATIC = { false, false, true, true }
        SOUNDS = { "sounds/combat/knife.wav", "sounds/combat/pistol.wav", "sounds/combat/machine_gun.wav",
                         "sounds/combat/chain_gun.wav" }
        NAMES = { "KNIFE", "PISTOL", "MACHINE GUN", "CHAIN GUN" }
        ids = {}
        shown = {}
