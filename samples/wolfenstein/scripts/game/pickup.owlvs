FormatVersion: 1
VisualScript:
  variables:
    - {name: item, type: string, default: Cross}
    - {name: sparks, type: int, default: "28", min: 0}
    - {name: sparkle_ahead, type: float, default: "0.55", min: 0}
    - {name: sparkle_height, type: float, default: "-0.2"}
    - {name: KINDS, type: numbers, default: "", exposed: false}
    - {name: MAX_AMMO, type: float, default: "99", exposed: false}
    - {name: MAX_HEALTH, type: float, default: "100", exposed: false}
    - {name: collected, type: bool, default: "false", exposed: false}
    - {name: id, type: entity, default: "0", exposed: false}
    - {name: x, type: float, default: "0", exposed: false}
    - {name: y, type: float, default: "0", exposed: false}
    - {name: yaw, type: float, default: "0", exposed: false}
    - {name: kind, type: float, default: "0", exposed: false}
  functions:
    - name: sparkle
      inputs: [{name: name, type: any}, {name: other_id, type: any}]
      outputs: []
      exported: true
  customNodes:
    - name: init_state
      title: Init State
      inputs: []
      outputs: []
      code: |
        KINDS = {
            Cross = { score = 100, label = "Cross", sound = "sounds/game/treasure.wav" },
            Chalice = { score = 500, label = "Chalice", sound = "sounds/game/treasure.wav" },
            Chest = { score = 1000, label = "Treasure chest", sound = "sounds/game/treasure.wav" },
            Crown = { score = 5000, label = "Crown", sound = "sounds/game/treasure.wav" },
            Food = { score = 20, health = 10, label = "Roast dinner", sound = "sounds/game/food.wav" },
            DogFood = { score = 10, health = 4, label = "Dog food", sound = "sounds/game/food.wav" },
            GoldKey = { key = "gold", label = "Gold key", sound = "sounds/game/key.wav" },
            BlueKey = { key = "blue", label = "Blue key", sound = "sounds/game/key.wav", sparkle = "BlueSparkle" },
            Ammo = { ammo = 8, label = "Ammo  +8", sound = "sounds/combat/ammo.wav", gear = true },
            Clip = { ammo = 4, label = "Ammo  +4", sound = "sounds/combat/ammo.wav", gear = true },
            FirstAid = { health = 25, label = "First aid kit  +25%", sound = "sounds/combat/health.wav", gear = true },
            MachineGun = { weapon = 3, ammo = 6, label = "Machine gun! (3)", sound = "sounds/combat/weapon.wav", gear = true },
            ChainGun = { weapon = 4, ammo = 6, label = "Chain gun! (4)", sound = "sounds/combat/weapon.wav", gear = true },
        }
