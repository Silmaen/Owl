Scene: untitled
FormatVersion: 5
Hud: huds/play.owlhud
EnabledRenderers:
  - Name: world
    Enabled: false
  - Name: raycast_world
    Enabled: true
    Overrides:
      FloorColor: [0.36, 0.38, 0.42, 1]
      CeilingColor: [0.14, 0.15, 0.2, 1]
  - Name: overlay
    Enabled: true
    Overrides:
      Space: Screen
Entities:
  - Entity: 5494361375484207096
    Tag:
      tag: Player
    Transform:
      translation: [-0.5, -13.5, 0.5]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Camera:
      camera:
        projectionType: Orthographic
        perspectiveFOV: 0.7853982
        perspectiveNear: 0.01
        perspectiveFar: 1000
        orthographicSize: 8
        orthographicNear: -1
        orthographicFar: 10
      primary: true
      fixedAspectRatio: false
    PhysicBody:
      type: Dynamic
      fixedRotation: true
      colliderSize: [0.4, 0.4, 1]
      density: 1
      restitution: 0
      friction: 0.2
    Player:
      primary: true
      linearImpulse: 0
      jumpImpulse: 0
      canJump: false
    Visibility:
      gameVisible: true
    SoundListener:
      primary: true
    LuaScript:
      scriptPath: scripts/game/player.lua
      properties:
        - name: speed
          type: float
          value: 3
        - name: turn_speed
          type: float
          value: 1.8
        - name: mouse_turn
          type: float
          value: 0.006
  - Entity: 8294608321799196041
    Tag:
