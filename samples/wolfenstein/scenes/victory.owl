Scene: untitled
FormatVersion: 5
EnabledRenderers:
  - Name: raycast_world
    Enabled: false
Entities:
  - Entity: 4300000000000000001
    Tag:
      tag: MainCamera
    Transform:
      translation: [0, 0, 5]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Camera:
      camera:
        projectionType: Orthographic
        perspectiveFOV: 0.785398185
        perspectiveNear: 0.00999999978
        perspectiveFar: 1000
        orthographicSize: 10
        orthographicNear: -1
        orthographicFar: 10
