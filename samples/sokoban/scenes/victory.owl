Scene: victory
FormatVersion: 5
Entities:
  - Entity: 7330000000000000001
    Tag:
      tag: MainCamera
    Transform:
      translation: [0, 0, 5]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy: {}
    Camera:
      camera:
        projectionType: Orthographic
        perspectiveFOV: 0.7853982
        perspectiveNear: 0.01
        perspectiveFar: 1000
        orthographicSize: 10
        orthographicNear: -1
        orthographicFar: 10
      primary: true
      fixedAspectRatio: false
  - Entity: 7330000000000000002
    Tag:
      tag: Background
    Transform:
      translation: [0, 0, -1]
      rotation: [0, 0, 0]
      scale: [40, 30, 1]
    Visibility:
      gameVisible: true
    Hierarchy: {}
    BackgroundTexture:
      mode: 0
      type: 0
      color: [0.05, 0.09, 0.05, 1]
      topColor: [0.8, 0.9, 1, 1]
  - Entity: 7330000000000000003
    Tag:
      tag: VictoryCanvas
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy: {}
    Canvas:
      space: ScreenOverlay
      sortOrder: 0
      referenceResolution: [1280, 720]
      scaleMode: ScaleWithHeight
    LuaScript:
      scriptPath: scripts/ui/victory.lua
  - Entity: 7330000000000000004
    Tag:
      tag: ResultGroup
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 7330000000000000003
    UiRect:
      anchorMin: [0.5, 0.5]
      anchorMax: [0.5, 0.5]
      pivot: [0.5, 0.5]
      size: [0.9, 0.7]
      sizeUnit: [ScreenHeight, ScreenHeight]
      offset: [0, 0]
    UiLayout:
      arrangement: Column
      crossAlign: Center
      spacing: 8
      padding: 0
      columns: 1
      cellSize: [0, 0]
  - Entity: 7330000000000000005
    Tag:
      tag: ButtonRow
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 7330000000000000004
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [1, 0.18]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiLayout:
      arrangement: Row
      crossAlign: Center
      spacing: 12
      padding: 0
      columns: 1
      cellSize: [0, 0]
  - Entity: 7330000000000000006
    Tag:
      tag: TitleButton
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 7330000000000000005
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [0.48, 1]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiButton:
      normalColor: [0.3, 0.3, 0.3, 1]
      hoverColor: [0.4, 0.4, 0.4, 1]
      pressedColor: [0.25, 0.25, 0.25, 1]
      disabledColor: [0.15, 0.15, 0.15, 0.5]
      onClickCallback: on_title_clicked
    UiText:
      outlineWidth: 2
      text: 'Title'
      color: [1, 1, 1, 1]
      fontSize: 32
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0
      wrap: false
      fit: Shrink
      minFontSize: 12
    UiFocus:
      focusable: true
      initial: false
      onFocusCallback: ''
      highlightColor: [1, 0.82, 0.2, 1]
      highlightThickness: 2
  - Entity: 7330000000000000007
    Tag:
      tag: LevelsButton
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 7330000000000000005
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [0.48, 1]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiButton:
      normalColor: [0.15, 0.35, 0.65, 1]
      hoverColor: [0.25, 0.45, 0.75, 1]
      pressedColor: [0.1, 0.3, 0.6, 1]
      disabledColor: [0.15, 0.15, 0.15, 0.5]
      onClickCallback: on_levels_clicked
    UiText:
      outlineWidth: 2
      text: 'Level select'
      color: [1, 1, 1, 1]
      fontSize: 32
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0
      wrap: false
      fit: Shrink
      minFontSize: 12
    UiFocus:
      focusable: true
      initial: true
      onFocusCallback: ''
      highlightColor: [1, 0.82, 0.2, 1]
      highlightThickness: 2
  - Entity: 7330000000000000008
    Tag:
      tag: ScoreLabel
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 7330000000000000004
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [1, 0.2]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiText:
      outlineWidth: 2
      text: 'Levels done: 10 / 10'
      color: [1, 1, 1, 1]
      fontSize: 34
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0
      wrap: true
      fit: Shrink
      minFontSize: 12
  - Entity: 7330000000000000009
    Tag:
      tag: VictoryTitle
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 7330000000000000004
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [1, 0.34]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiText:
      outlineWidth: 2
      text: 'Warehouse cleared!'
      color: [1, 0.82, 0.3, 1]
      fontSize: 80
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
