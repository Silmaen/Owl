      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy: {}
    Canvas:
      space: ScreenOverlay
      sortOrder: 0
      referenceResolution: [1280, 720]
      scaleMode: ScaleWithHeight
    LuaScript:
      scriptPath: scripts/ui/settings.lua
  - Entity: 7320000000000000004
    Tag:
      tag: SettingsList
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 7320000000000000003
    UiRect:
      anchorMin: [0.5, 0.5]
      anchorMax: [0.5, 0.5]
      pivot: [0.5, 0.5]
      size: [0.9, 0.9]
      sizeUnit: [ScreenHeight, ScreenHeight]
      offset: [0, 0]
    UiLayout:
      arrangement: Column
      crossAlign: Center
      spacing: 6
      padding: 4
      columns: 1
      cellSize: [0, 0]
  - Entity: 7320000000000000005
    Tag:
      tag: BackButton
