Scene: settings
FormatVersion: 5
Entities:
  - Entity: 7320000000000000001
    Tag:
      tag: MainCamera
    Transform:
      translation: [0, 0, 5]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy: {}
    Camera:
      camera:
        projectionType: Orthographic
        perspectiveFOV: 0.7853982
        perspectiveNear: 0.01
        perspectiveFar: 1000
        orthographicSize: 10
        orthographicNear: -1
        orthographicFar: 10
      primary: true
      fixedAspectRatio: false
  - Entity: 7320000000000000002
    Tag:
      tag: Background
    Transform:
      translation: [0, 0, -1]
      rotation: [0, 0, 0]
      scale: [40, 30, 1]
    Visibility:
      gameVisible: true
    Hierarchy: {}
    BackgroundTexture:
      mode: 0
      type: 0
      color: [0.06, 0.06, 0.09, 1]
      topColor: [0.8, 0.9, 1, 1]
