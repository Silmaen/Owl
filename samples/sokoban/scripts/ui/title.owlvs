VisualScript:
  variables:
    - {name: wipe_color, type: color, default: "0.2, 0.12, 0.05, 1"}
    - {name: levels, type: numbers, default: "", exposed: false}
    - {name: leaving, type: bool, default: "false", exposed: false}
    - {name: next_level, type: float, default: "1", exposed: false}
    - {name: window_id, type: entity, default: "0", exposed: false}
