  functions:
    - name: leave
      inputs: [{name: path, type: any}, {name: jingle, type: any}]
      outputs: []
    - name: set
      inputs: [{name: name, type: any}, {name: text, type: any}]
      outputs: [{name: result, type: any}]
    - name: on_how_to_closed
      inputs: []
      outputs: []
      exported: true
  customNodes:
    - name: init_state
      title: Init State
      inputs: []
      outputs: []
      code: |
        levels = nil
    - name: require_levels
      title: Require levels
      inputs: []
      outputs: [{name: module, type: any}]
      code: |
        return require("scripts.game.levels")
