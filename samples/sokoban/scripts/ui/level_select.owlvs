      inputs: [{name: i, type: any}]
      outputs: [{name: result, type: any}]
    - name: best
      inputs: [{name: i, type: any}]
      outputs: [{name: result, type: any}]
    - name: show_info
      inputs: []
      outputs: []
    - name: on_play_clicked
      inputs: []
      outputs: []
      exported: true
    - name: go_back
      inputs: []
      outputs: []
      exported: true
  customNodes:
    - name: init_state
      title: Init State
      inputs: []
      outputs: []
      code: |
        levels = nil
    - name: require_levels
      title: Require levels
      inputs: []
      outputs: [{name: module, type: any}]
      code: |
        return require("scripts.game.levels")
