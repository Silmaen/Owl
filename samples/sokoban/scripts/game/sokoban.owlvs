  functions:
    - name: terrain
      inputs: [{name: layer, type: any}, {name: x, type: any}, {name: y, type: any}]
      outputs: [{name: result, type: any}]
    - name: is_floor
      inputs: [{name: x, type: any}, {name: y, type: any}]
      outputs: [{name: result, type: any}]
    - name: is_goal
      inputs: [{name: x, type: any}, {name: y, type: any}]
      outputs: [{name: result, type: any}]
    - name: is_box
      inputs: [{name: x, type: any}, {name: y, type: any}]
      outputs: [{name: result, type: any}]
    - name: put_box
      inputs: [{name: x, type: any}, {name: y, type: any}, {name: present, type: any}]
      outputs: []
      exported: true
    - name: cell_to_world
      inputs: [{name: x, type: any}, {name: y, type: any}]
      outputs: [{name: result, type: any}, {name: result_2, type: any}]
    - name: count_goals
      inputs: []
      outputs: [{name: result, type: any}]
      exported: true
    - name: set_text
      inputs: [{name: key, type: any}, {name: text, type: any}]
      outputs: []
    - name: show_message
      inputs: [{name: text, type: any}, {name: seconds, type: any}]
      outputs: []
      exported: true
