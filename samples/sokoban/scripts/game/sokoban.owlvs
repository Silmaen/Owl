      outputs: [{name: result, type: any}]
    - name: done_key
      inputs: []
      outputs: [{name: result, type: any}]
    - name: update_hud
      inputs: []
      outputs: []
    - name: publish
      inputs: []
      outputs: []
      exported: true
    - name: puff
      inputs: [{name: id, type: any}, {name: count, type: any}, {name: x, type: any}, {name: y, type: any}, {name: lift, type: any}]
      outputs: []
    - name: place_player
      inputs: [{name: frame, type: any}]
      outputs: []
      exported: true
    - name: finish_slide
      inputs: []
      outputs: []
      exported: true
    - name: check_win
      inputs: []
      outputs: []
    - name: step
      inputs: [{name: dx, type: any}, {name: dy, type: any}]
      outputs: []
    - name: update_slide
      inputs: [{name: dt, type: any}]
      outputs: []
    - name: set_paused
      inputs: [{name: value, type: any}]
      outputs: []
    - name: leave
      inputs: [{name: path, type: any}]
      outputs: []
    - name: read_direction
      inputs: []
      outputs: [{name: result, type: any}, {name: result_2, type: any}]
    - name: read_stick
      inputs: []
      outputs: [{name: result, type: any}]
    - name: is_held
      inputs: [{name: action, type: any}]
      outputs: [{name: result, type: any}]
    - name: update_input
      inputs: [{name: dt, type: any}]
      outputs: []
  customNodes:
    - name: init_state
      title: Init State
      inputs: []
      outputs: []
      code: |
        SLIDE_TIME = nil
        REPEAT_DELAY = nil
        REPEAT_TIME = nil
        WIN_DELAY = nil
        DIRECTIONS = {
            step_left = { -1, 0 },
            step_right = { 1, 0 },
            step_up = { 0, -1 },
            step_down = { 0, 1 },
        }
        levels = nil
        hud = {}
        history = {}
        slide = nil
        held = nil
        queued = nil
        stick_dir = nil
        shown = {}
    - name: require_levels
      title: Require levels
      inputs: []
      outputs: [{name: module, type: any}]
      code: |
        return require("scripts.game.levels")
    - name: take_back
      title: Take back
      inputs: []
      outputs: [{name: r1, type: any}]
      code: |
        local last = table.remove(history)
        if last == nil then return false end
        local dx, dy, pushed = last[1], last[2], last[3]
        if pushed then
            put_box(px + dx, py + dy, false)
            put_box(px, py, true)
            pushes = pushes - 1
        end
        px, py = px - dx, py - dy
        moves = moves - 1
        return true
    - name: undo
      title: Undo
      inputs: []
      outputs: []
      code: |
        finish_slide()
        if won then return end
        if take_back() then
            sound.play("sounds/game/undo.wav")
            place_player(frame_idle)
            on_goal = count_goals()
            publish()
        end
    - name: restart
      title: Restart
      inputs: []
      outputs: []
      code: |
        finish_slide()
        if won or #history == 0 then return end
        while take_back() do end
        moves, pushes = 0, 0
        sound.play("sounds/game/restart.wav")
        place_player(frame_idle)
        on_goal = count_goals()
        publish()
        show_message("Restarted", 0.8)
