    next: 7790000000000000001
  - id: 7790000000000000001
    kind: Line
    position: [260, 120]
    speaker: {text: Old man, key: dialogue.old_man.name}
    text: {text: 'Ah, a visitor! Few come down to the Sunken Shrine any more.', key: dialogue.old_man.line_1}
    next: 7790000000000000002
  - id: 7790000000000000002
    kind: Line
    position: [520, 120]
    speaker: {text: Old man, key: dialogue.old_man.name}
    text: {text: 'Its guardian sleeps behind three doors. A key, fire and stone open them.', key: dialogue.old_man.line_2}
    next: 7790000000000000003
  - id: 7790000000000000003
    kind: Line
    position: [780, 120]
    speaker: {text: Old man, key: dialogue.old_man.name}
    text: {text: 'The key lies in the pit to the north. In the armoury to the east, a sword waits for a hand.', key: dialogue.old_man.line_3}
    next: 7790000000000000004
  - id: 7790000000000000004
    kind: Line
    position: [1040, 120]
    speaker: {text: Old man, key: dialogue.old_man.name}
    text: {text: 'Go, and may the light of the braziers guide you.', key: dialogue.old_man.line_4}
    next: 7790000000000000005
  - id: 7790000000000000005
    kind: End
    position: [1300, 120]
