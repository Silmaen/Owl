  - Entity: 7300000681149000030
    Tag:
      tag: HowToRules
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 7300000681149000026
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [0.94, 0.36]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiText:
      outlineWidth: 2
      text: 'Beneath the hall of the shrine sleeps its guardian, behind three doors: a key opens the first, fire the second, stone the third. Talk to the old man, find the key in the pit, take the sword in the armoury, light the four braziers of the dark crypt, push the block onto its plate, and defeat the guardian to take the heart of the shrine. Creatures cost you a heart when they touch you; with none left you fall, and Retry takes you back to the door of the room. Each room you enter is saved: Continue on the title goes on from there.'
      color: [0.85, 0.8, 0.72, 1]
      fontSize: 22
      horizontalAlignment: Left
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0.2
      wrap: true
      fit: Shrink
      minFontSize: 12
