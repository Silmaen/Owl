            "scenes/level_1.owl",
            "scenes/level_2.owl",
            "scenes/level_3.owl",
            "scenes/level_4.owl",
            "scenes/level_5.owl",
        }
        LEVEL_NAMES = { "First wall", "Pyramid", "Checkers", "Fortress", "Last stand" }
