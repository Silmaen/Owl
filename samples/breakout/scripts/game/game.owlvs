FormatVersion: 1
VisualScript:
  variables:
    - {name: level, type: int, default: "1"}
    - {name: next_scene, type: string, default: scenes/victory.owl}
    - {name: paddle_y, type: float, default: "-6.8"}
    - {name: paddle_half_height, type: float, default: "0.18"}
    - {name: power_fall, type: float, default: "3"}
    - {name: power_points, type: int, default: "50"}
    - {name: slow_factor, type: float, default: "0.65"}
    - {name: burst_time, type: float, default: "0.9", min: 0.1}
    - {name: burst_sparks, type: int, default: "36", min: 1}
    - {name: wipe_color, type: color, default: "0.45, 0.05, 0.55, 1"}
    - {name: wide_time, type: float, default: "15", min: 0}
    - {name: slow_time, type: float, default: "12", min: 0}
    - {name: clear_delay, type: float, default: "1.6", min: 0}
    - {name: over_delay, type: float, default: "1.4", min: 0}
    - {name: FIRST_LEVEL, type: string, default: scenes/level_1.owl, exposed: false}
    - {name: PADDLE_Y, type: float, default: "0", exposed: false}
    - {name: PADDLE_HALF_HEIGHT, type: float, default: "0", exposed: false}
    - {name: POWER_FALL, type: float, default: "0", exposed: false}
    - {name: POWER_POINTS, type: int, default: "0", exposed: false}
    - {name: SLOW_FACTOR, type: float, default: "0", exposed: false}
    - {name: POWER_HALF_W, type: float, default: "0.6", exposed: false}
    - {name: POWER_HALF_H, type: float, default: "0.26", exposed: false}
    - {name: BURST_PREFAB, type: string, default: prefabs/brick_burst.owlprefab, exposed: false}
    - {name: POWER_PREFABS, type: numbers, default: "", exposed: false}
    - {name: hud, type: numbers, default: "", exposed: false}
    - {name: bursts, type: numbers, default: "", exposed: false}
    - {name: powers, type: numbers, default: "", exposed: false}
    - {name: paused, type: bool, default: "false", exposed: false}
    - {name: ending, type: string, default: "", exposed: false}
    - {name: end_clock, type: float, default: "0", exposed: false}
    - {name: wide_clock, type: float, default: "0", exposed: false}
    - {name: slow_clock, type: float, default: "0", exposed: false}
    - {name: message_clock, type: float, default: "0", exposed: false}
    - {name: shown, type: numbers, default: "", exposed: false}
    - {name: id, type: entity, default: "0", exposed: false}
    - {name: tmp_1, type: numbers, default: "", exposed: false}
    - {name: drop_power_id, type: entity, default: "0", exposed: false}
    - {name: tmp_2, type: numbers, default: "", exposed: false}
    - {name: item, type: float, default: "0", exposed: false}
    - {name: t, type: float, default: "0", exposed: false}
    - {name: px, type: float, default: "0", exposed: false}
    - {name: half, type: float, default: "0", exposed: false}
    - {name: update_power_ups_item, type: float, default: "0", exposed: false}
    - {name: touches, type: bool, default: "false", exposed: false}
    - {name: tmp_3, type: bool, default: "false", exposed: false}
    - {name: caught, type: float, default: "0", exposed: false}
    - {name: points, type: float, default: "0", exposed: false}
    - {name: target, type: string, default: "", exposed: false}
  functions:
    - name: set_text
      inputs: [{name: key, type: any}, {name: text, type: any}]
      outputs: []
    - name: show_message
      inputs: [{name: text, type: any}, {name: seconds, type: any}]
      outputs: []
    - name: burst
      inputs: [{name: x, type: any}, {name: y, type: any}, {name: r, type: any}, {name: g, type: any}, {name: b, type: any}]
      outputs: []
      exported: true
    - name: drop_power
      inputs: [{name: kind, type: any}, {name: x, type: any}, {name: y, type: any}]
      outputs: []
      exported: true
    - name: update_bursts
      inputs: [{name: dt, type: any}]
      outputs: []
    - name: catch
      inputs: [{name: kind, type: any}]
      outputs: []
    - name: update_power_ups
      inputs: [{name: dt, type: any}]
      outputs: []
    - name: update_timers
      inputs: [{name: dt, type: any}]
      outputs: []
    - name: set_paused
      inputs: [{name: value, type: any}]
      outputs: []
    - name: update_hud
      inputs: []
      outputs: []
    - name: save_progress
      inputs: []
      outputs: []
    - name: check_end
      inputs: [{name: dt, type: any}]
      outputs: []
  customNodes:
    - name: init_state
      title: Init State
      inputs: []
      outputs: []
      code: |
        PADDLE_Y = nil
        PADDLE_HALF_HEIGHT = nil
        POWER_FALL = nil
        POWER_POINTS = nil
        SLOW_FACTOR = nil
        POWER_PREFABS = { wide = "prefabs/power_wide.owlprefab", slow = "prefabs/power_slow.owlprefab" }
        hud = {}
        bursts = {}
        powers = {}
        ending = nil
        shown = {}
    - name: read_events
      title: Read events
      inputs: []
      outputs: []
      code: |
        local queue = gamestate.get("breakout_events", "")
        if queue == "" then return end
        gamestate.set("breakout_events", "")
        for kind, x, y, r, g, b in string.gmatch(queue, "(%a+) (%S+) (%S+) (%S+) (%S+) (%S+);") do
            x, y = tonumber(x), tonumber(y)
            if kind == "break" then
                burst(x, y, tonumber(r), tonumber(g), tonumber(b))
            elseif POWER_PREFABS[kind] then
                drop_power(kind, x, y)
            end
        end
  nodes:
