DataTable: ''
FormatVersion: 1
columns:
  - {name: name, type: Text}
  - {name: hint, type: Text}
  - {name: hp, type: Float}
  - {name: speed, type: Float}
  - {name: gold, type: Integer}
  - {name: arrow, type: Float}
  - {name: lives, type: Integer}
  - {name: boss, type: Bool}
  - {name: ability, type: Enum, choices: [none, regen, ward, blast, rage, rally]}
  - {name: power, type: Float}
  - {name: radius, type: Float}
  - {name: every, type: Float}
  - {name: bar_height, type: Float}
  - {name: shadow_size, type: Float}
