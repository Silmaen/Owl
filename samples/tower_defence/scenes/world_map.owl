      space: ScreenOverlay
      sortOrder: 0
      referenceResolution: [1280, 720]
      scaleMode: ScaleWithHeight
    LuaScript:
      scriptPath: scripts/ui/world_map.lua
      properties:
        - name: levels
          type: strings
          value:
            - 'Greenmarch Ford|8|The second power-up of each tower|goblins, orc grunts, ogres'
            - 'Thornwood Pass|10|Rain of arrows: a spell on the enemy nearest the keep|wolf riders'
            - 'Stonebridge|10|Royal treasury: 60 more gold at the start of every level|trolls'
            - 'Frostmere|10|Shield wall: a spell stopping the enemies around the front one|goblin sappers, ogre mages'
            - 'The Black Gate|12|Keep walls, with 3 stars on all five: 5 more lives|the orc chieftain'
        - name: level_scenes
          type: strings
          value:
            - 'scenes/level_01.owl'
            - 'scenes/level_02.owl'
            - 'scenes/level_03.owl'
            - 'scenes/level_04.owl'
            - 'scenes/level_05.owl'
