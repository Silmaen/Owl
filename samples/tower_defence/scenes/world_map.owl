    Tag:
      tag: MapCanvas
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy: {}
    Canvas:
      space: ScreenOverlay
      sortOrder: 0
      referenceResolution: [1280, 720]
      scaleMode: ScaleWithHeight
    LuaScript:
      scriptPath: scripts/ui/world_map.lua
      properties:
        - name: levels
          type: strings
          value:
            - 'Greenmarch Ford|8|The second power-up of each tower|goblins, orc grunts, ogres|'
            - 'Thornwood Pass|10|Rain of arrows: a spell on the enemy nearest the keep|wolf riders|fog'
            - 'Stonebridge|10|Royal treasury: 60 more gold at the start of every level|trolls|'
            - 'Mirefen Marsh|10|Fletchers'' guild: archers cost 10% less|goblin sappers|fog'
            - 'Frostmere|10|Shield wall: a spell stopping the enemies around the front one|ogre mages|blizzard'
            - 'Highpeak Watch|11|Watchtowers: every tower sees 5% further|orc berserkers|gale'
            - 'Sunscorch Flats|10|Harvest tithe: 10% more gold per kill||drought'
            - 'Ashfall Ridge|11|Night watch: towers see 10% further at night||blood moon'
            - 'Ravenhold|12|Royal guard: 3 more lives on every level||plunder, long night'
            - 'The Black Gate|12|Keep walls, with 3 stars on all ten: 5 more lives|the orc chieftain|blood moon'
