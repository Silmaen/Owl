FormatVersion: 1
VisualScript:
  variables:
    - {name: ui_scale_min, type: float, default: "0.75", min: 0.1}
    - {name: ui_scale_max, type: float, default: "2", min: 0.1}
    - {name: map_count, type: int, default: "10", min: 1}
    - {name: wipe_color, type: color, default: "0.1, 0.14, 0.24, 1"}
    - {name: VOLUMES, type: numbers, default: "", exposed: false}
    - {name: COLOUR_MODES, type: numbers, default: "", exposed: false}
    - {name: COLOUR_NAMES, type: numbers, default: "", exposed: false}
    - {name: DEFAULTS, type: numbers, default: "", exposed: false}
    - {name: ids, type: numbers, default: "", exposed: false}
    - {name: leaving, type: bool, default: "false", exposed: false}
    - {name: done, type: float, default: "0", exposed: false}
    - {name: value, type: float, default: "0", exposed: false}
    - {name: scale, type: float, default: "0", exposed: false}
    - {name: mode, type: float, default: "0", exposed: false}
    - {name: on_ui_scale_changed_value, type: float, default: "0", exposed: false}
    - {name: current, type: float, default: "0", exposed: false}
    - {name: next_mode, type: float, default: "0", exposed: false}
    - {name: shown, type: bool, default: "false", exposed: false}
  functions:
    - name: percent
      inputs: [{name: value, type: any}]
      outputs: [{name: result, type: any}]
    - name: set
      inputs: [{name: tag, type: any}, {name: text, type: any}]
      outputs: []
    - name: on_off
      inputs: [{name: flag, type: any}]
      outputs: [{name: result, type: any}]
    - name: maps_done
      inputs: []
      outputs: [{name: result, type: any}]
    - name: refresh
      inputs: []
      outputs: []
    - name: set_volume
      inputs: [{name: setting, type: any}]
      outputs: []
    - name: go_back
      inputs: []
      outputs: []
      exported: true
  customNodes:
    - name: init_state
      title: Init State
      inputs: []
      outputs: []
      code: |
        VOLUMES = {
            { setting = "volume_master", slider = "MasterVolSlider", label = "MasterVolLabel", text = "Master volume" },
            { setting = "volume_music", slider = "MusicVolSlider", label = "MusicVolLabel", text = "Music" },
            { setting = "volume_sfx", slider = "SfxVolSlider", label = "SfxVolLabel", text = "Effects" },
        }
        COLOUR_MODES = { "none", "protanopia", "deuteranopia", "tritanopia" }
        COLOUR_NAMES = { none = "off", protanopia = "red-blind", deuteranopia = "green-blind",
                               tritanopia = "blue-blind" }
        DEFAULTS = { "volume_master", "volume_music", "volume_sfx", "ui_scale", "color_blind_mode", "reduced_motion",
                           "subtitles" }
        ids = {}
