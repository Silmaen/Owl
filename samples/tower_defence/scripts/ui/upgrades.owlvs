FormatVersion: 1
VisualScript:
  variables:
    - {name: map_scene, type: string, default: scenes/world_map.owl}
    - {name: levels, type: int, default: "10", min: 1}
    - {name: wipe_color, type: color, default: "0.1, 0.14, 0.24, 1"}
    - {name: FAMILIES, type: numbers, default: "", exposed: false}
    - {name: TIERS, type: float, default: "4", exposed: false}
    - {name: ids, type: numbers, default: "", exposed: false}
    - {name: leaving, type: bool, default: "false", exposed: false}
    - {name: total, type: float, default: "0", exposed: false}
    - {name: stars_spent_total, type: float, default: "0", exposed: false}
    - {name: bought, type: float, default: "0", exposed: false}
    - {name: tmp_1, type: bool, default: "false", exposed: false}
    - {name: won, type: float, default: "0", exposed: false}
    - {name: spent, type: float, default: "0", exposed: false}
    - {name: free, type: float, default: "0", exposed: false}
    - {name: row, type: float, default: "0", exposed: false}
    - {name: refresh_bought, type: float, default: "0", exposed: false}
    - {name: cost, type: float, default: "0", exposed: false}
    - {name: text, type: string, default: "", exposed: false}
    - {name: can, type: bool, default: "false", exposed: false}
    - {name: family, type: float, default: "0", exposed: false}
    - {name: buy_bought, type: float, default: "0", exposed: false}
    - {name: pips, type: numbers, default: "", exposed: false}
    - {name: tmp_2, type: numbers, default: "", exposed: false}
  functions:
    - name: setting_key
      inputs: [{name: family, type: any}]
      outputs: [{name: result, type: any}]
    - name: tier_of
      inputs: [{name: family, type: any}]
      outputs: [{name: result, type: any}]
    - name: stars_won
      inputs: []
      outputs: [{name: result, type: any}]
    - name: stars_spent
      inputs: []
      outputs: [{name: result, type: any}]
    - name: unlocked
      inputs: [{name: family, type: any}]
      outputs: [{name: result, type: any}]
    - name: refresh
      inputs: []
      outputs: []
    - name: buy
      inputs: [{name: index, type: any}]
      outputs: []
    - name: on_back_clicked
      inputs: []
      outputs: []
      exported: true
  customNodes:
    - name: init_state
      title: Init State
      inputs: []
      outputs: []
      code: |
        FAMILIES = {
            { key = "archer", name = "Archers", tiers = { "Bodkin arrows: +15% damage", "Longbows: +12% range",
                                                          "Drilled archers: shoot 15% faster",
                                                          "Master bowyers: +10% range" } },
            { key = "cannon", name = "Cannons", tiers = { "Guild foundry: cannons cost 15% less",
                                                          "Black powder: 20% wider bursts", "Heavy shells: +20% damage",
                                                          "Bronze barrels: shoot 15% faster" } },
            { key = "frost", name = "Frost", tiers = { "Deep cold: the chill lasts 30% longer",
                                                       "Bitter frost: chilled enemies are slower", "Rime: +12% range",
                                                       "Hoarfrost: +20% damage" } },
            { key = "rain", name = "Rain of arrows", unlock = "tower_done_02", unlock_text = "win Thornwood Pass",
              tiers = { "Fletchers: ready 20% sooner", "Broadheads: +30% damage", "Volley: a 25% wider rain",
                        "Storm of arrows: +30% damage" } },
            { key = "shield", name = "Shield wall", unlock = "tower_done_05", unlock_text = "win Frostmere",
              tiers = { "Drill: ready 20% sooner", "Iron wall: holds 2 seconds more", "Wide wall: 25% wider",
                        "Bastion: ready 20% sooner again" } },
            { key = "treasury", name = "Treasury", tiers = { "War chest: +40 gold at the start",
                                                             "Bounties: +10% gold per kill", "Masons: +2 lives",
                                                             "Royal mint: +60 gold at the start" } },
        }
        ids = {}
