  functions:
    - name: clock_text
      inputs: [{name: seconds, type: any}]
      outputs: [{name: result, type: any}]
    - name: text_of
      inputs: [{name: line, type: any}, {name: value, type: any}]
      outputs: [{name: result, type: any}]
    - name: finish_count
      inputs: []
      outputs: []
    - name: leave
      inputs: [{name: path, type: any}]
      outputs: []
  customNodes:
    - name: init_state
      title: Init State
      inputs: []
      outputs: []
      code: |
        lines = {}
