FormatVersion: 1
VisualScript:
  variables:
    - {name: level_number, type: int, default: "1", min: 1}
    - {name: level_name, type: string, default: Greenmarch Ford}
    - {name: scene_path, type: string, default: scenes/level_01.owl}
    - {name: next_scene, type: string, default: scenes/victory.owl}
    - {name: waves_table, type: string, default: tables/waves_01.owltable}
    - {name: towers_table, type: string, default: tables/towers.owltable}
    - {name: enemies_table, type: string, default: tables/enemies.owltable}
    - {name: briefing_dialogue, type: string, default: dialogues/briefing_01.owldlg}
    - {name: start_towers, type: strings, default: ""}
    - {name: modifiers, type: strings, default: ""}
    - {name: new_enemies, type: string, default: ""}
    - {name: briefing, type: bool, default: "true"}
    - {name: tutorial, type: bool, default: "false"}
    - {name: time_effects, type: strings, default: "archer day damage 1.1, archer night range 0.85, cannon day splash 1.15, cannon night reload 1.15, frost day time 0.8, frost night time 1.4, goblin day speed 0.9, goblin night speed 1.15, grunt day taken 0.9, grunt night speed 1.1, ogre day speed 0.85, ogre night hp 1.15, wolf day taken 1.15, wolf night speed 1.2, troll day regen 0, troll night regen 1.5, ogre_mage day ward 0.8, ogre_mage night ward 1.5, sapper day speed 0.9, sapper night speed 1.2, berserker day taken 1.1, berserker night speed 1.15, chieftain day taken 1.1, chieftain night taken 0.85"}
    - {name: start_hour, type: float, default: "9.5", min: 0, max: 24}
    - {name: night_hour, type: float, default: "21.5", min: 0, max: 24}
    - {name: morning_hour, type: float, default: "8", min: 0, max: 24}
    - {name: start_gold, type: int, default: "240", min: 0}
    - {name: lives, type: int, default: "20", min: 1}
    - {name: map_width, type: int, default: "18", min: 1}
    - {name: map_depth, type: int, default: "14", min: 1}
    - {name: first_wave_delay, type: float, default: "25", min: 0}
    - {name: wave_delay, type: float, default: "18", min: 0}
    - {name: early_bonus, type: float, default: "2", min: 0}
    - {name: hp_growth, type: float, default: "0.18", min: 0}
    - {name: sell_share, type: float, default: "0.5", min: 0, max: 1}
    - {name: height_step, type: float, default: "0.4", min: 0.01}
    - {name: height_bonus, type: float, default: "0.15", min: 0}
    - {name: upgrade_2_share, type: float, default: "0.8", min: 0}
    - {name: upgrade_3_share, type: float, default: "1.2", min: 0}
    - {name: power_share, type: float, default: "1.5", min: 0}
    - {name: fire_time, type: float, default: "3", min: 0}
    - {name: fire_damage, type: float, default: "7", min: 0}
    - {name: shock_push, type: float, default: "0.8", min: 0}
    - {name: freeze_time, type: float, default: "1", min: 0}
    - {name: aura_damage, type: float, default: "1.25", min: 1}
    - {name: rain_damage, type: float, default: "70", min: 0}
    - {name: rain_radius, type: float, default: "1.7", min: 0}
    - {name: rain_cooldown, type: float, default: "45", min: 0}
    - {name: shield_time, type: float, default: "5", min: 0}
    - {name: shield_radius, type: float, default: "1.8", min: 0}
    - {name: shield_cooldown, type: float, default: "60", min: 0}
