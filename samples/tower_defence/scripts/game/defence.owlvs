  functions:
    - name: finish
      inputs: [{name: won, type: any}]
      outputs: []
    - name: check_end
      inputs: []
      outputs: []
    - name: tutorial_offered
      inputs: []
      outputs: [{name: result, type: any}]
      exported: true
    - name: set_paused
      inputs: [{name: value, type: any}]
      outputs: []
    - name: on_tutorial_skipped
      inputs: []
      outputs: []
      exported: true
  customNodes:
    - name: init_state
      title: Init State
      inputs: []
      outputs: []
      code: |
        td = nil
        S = nil
        C = nil
        UI = nil
        Eco = nil
        Cam = nil
        World = nil
        Waves = nil
        Fx = nil
        Vis = nil
