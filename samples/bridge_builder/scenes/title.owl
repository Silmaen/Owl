  - Entity: 7300000559431000080
    Tag:
      tag: HowToControls
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 7300000559431000077
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [0.94, 0.4]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiText:
      outlineWidth: 2
      text: "CURSOR        mouse, arrows / W A S D, D-pad or left stick\nLAY A PART    left click, Space, A: from a node, then at its end\nERASE         right click, X, Delete, pad X (or stop drawing)\nUNDO          Z, Backspace, B\nKIND          1 2 3, Tab, LB / RB\nTEST RUN      R, Y (again to edit)\nVIEW          wheel, Q / E, middle drag, right stick, triggers\nGRID          G, Back\nPAUSE         Escape, P, Start"
      color: [1, 0.62, 0.25, 1]
      fontSize: 21
      horizontalAlignment: Left
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0.25
      wrap: true
      fit: Shrink
      minFontSize: 12
      font: JetBrainsMono-Regular
  - Entity: 7300000559431000081
    Tag:
      tag: HowToRules
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 7300000559431000077
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [0.94, 0.36]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiText:
      outlineWidth: 2
      text: 'Lay roads, wooden and steel beams from node to node across the gap, within the budget. Every vehicle must drive from the left cliff to the right one. Press TEST RUN: the bridge becomes real, its parts turn red as their joints take the load, and a joint pulled too hard snaps. Roads carry the vehicles; beams brace them, triangles hold best. A bridge that holds earns a star, two or three when it costs little. Edit it and try again as often as you like: the design is kept.'
      color: [0.85, 0.82, 0.75, 1]
      fontSize: 22
      horizontalAlignment: Left
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0.2
