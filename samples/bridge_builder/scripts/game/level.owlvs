FormatVersion: 1
VisualScript:
  variables:
    - {name: level, type: int, default: 1}
    - {name: level_name, type: string, default: FIRST CROSSING}
    - {name: this_scene, type: string, default: scenes/level_1.owl}
    - {name: next_scene, type: string, default: scenes/level_2.owl}
    - {name: budget, type: int, default: 2600, min: 0}
    - {name: star_budget, type: int, default: 1900, min: 0}
    - {name: vehicles, type: int, default: 1, min: 1}
    - {name: grid_min_x, type: int, default: -2}
    - {name: grid_min_y, type: int, default: -8}
    - {name: grid_max_x, type: int, default: 10}
    - {name: grid_max_y, type: int, default: 6}
    - {name: run_time, type: float, default: 30, min: 1}
    - {name: fov, type: float, default: 0.85, min: 0.1}
    - {name: levels, type: int, default: 6, min: 1}
    - {name: names, type: strings, default: 'FIRST CROSSING, MILL CREEK, LONG REACH, DEEP GORGE, THE STEP, GREAT RIVER'}
    - {name: state, type: string, default: build, exposed: false}
    - {name: clock, type: float, default: 0, exposed: false}
    - {name: paused, type: bool, default: false, exposed: false}
    - {name: leaving, type: bool, default: false, exposed: false}
    - {name: message_time, type: float, default: 0, exposed: false}
    - {name: warned, type: bool, default: false, exposed: false}
    - {name: total, type: float, default: 0, exposed: false}
    - {name: replay_wait, type: float, default: 0, exposed: false}
    - {name: stars, type: int, default: 0, exposed: false}
    - {name: grid, type: bool, default: false, exposed: false}
  functions:
    - name: build_update
      inputs: [{name: dt, type: number}]
      outputs: []
    - name: place
      inputs: []
      outputs: []
    - name: erase
      inputs: []
      outputs: []
    - name: undo
      inputs: []
      outputs: []
    - name: show_kind
      inputs: [{name: label, type: string}]
      outputs: []
    - name: refresh
      inputs: []
      outputs: []
    - name: begin_run
      inputs: []
      outputs: []
    - name: end_run
      inputs: []
      outputs: []
    - name: run_update
      inputs: [{name: dt, type: number}]
      outputs: []
    - name: fail
      inputs: [{name: reason, type: string}]
      outputs: []
    - name: win
      inputs: []
      outputs: []
    - name: tally
      inputs: []
      outputs: []
    - name: say
      inputs: [{name: text, type: string}]
      outputs: []
    - name: set_paused
      inputs: [{name: paused, type: boolean}]
      outputs: []
    - name: toggle_grid
      inputs: []
      outputs: []
