    Tag:
      tag: PauseControls
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 7599000000000000028
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [0.95, 0.5]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiText:
      outlineWidth: 2
      text: "CURSOR        mouse, arrows / W A S D, D-pad or left stick\nLAY A PART    left click, Space, A: from a node, then at its end\nERASE         right click, X, Delete, pad X (or stop drawing)\nUNDO          Z, Backspace, B\nKIND          1 2 3, Tab, LB / RB\nTEST RUN      R, Y (again to edit)\nVIEW          wheel, Q / E, middle drag, right stick, triggers\nGRID          G, Back\nPAUSE         Escape, P, Start"
      color: [1, 0.62, 0.25, 1]
      fontSize: 18
      horizontalAlignment: Left
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0.2
      wrap: true
      fit: Shrink
      minFontSize: 12
      font: JetBrainsMono-Regular
