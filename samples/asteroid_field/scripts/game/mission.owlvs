FormatVersion: 1
VisualScript:
  variables:
    - {name: waves, type: string, default: tables/waves.owltable}
    - {name: this_scene, type: string, default: scenes/mission.owl}
    - {name: freighter_bonus, type: int, default: 1000, min: 0}
    - {name: state, type: string, default: fly, exposed: false}
    - {name: clock, type: float, default: 0, exposed: false}
    - {name: paused, type: bool, default: false, exposed: false}
    - {name: leaving, type: bool, default: false, exposed: false}
    - {name: message_time, type: float, default: 0, exposed: false}
    - {name: brief_time, type: float, default: 8, exposed: false}
    - {name: seen_wave, type: int, default: 0, exposed: false}
  functions:
    - name: fly_update
      inputs: []
      outputs: []
    - name: order
      inputs: [{name: kind, type: string}]
      outputs: []
    - name: finish
      inputs: [{name: won, type: boolean}, {name: reason, type: string}]
      outputs: []
    - name: end_update
      inputs: [{name: dt, type: number}]
      outputs: []
    - name: say
      inputs: [{name: text, type: string}]
      outputs: []
    - name: set_paused
      inputs: [{name: paused, type: boolean}]
      outputs: []
    - name: enemy_fire
      inputs: [{name: ship, type: entity}, {name: dt, type: number}]
      outputs: [{name: ok, type: boolean}]
      exported: true
      category: Behaviour tree leaves
    - name: wingman_pick
      inputs: [{name: ship, type: entity}, {name: dt, type: number}]
      outputs: [{name: ok, type: boolean}]
      exported: true
      category: Behaviour tree leaves
    - name: wingman_fire
      inputs: [{name: ship, type: entity}, {name: dt, type: number}]
      outputs: [{name: ok, type: boolean}]
      exported: true
      category: Behaviour tree leaves
    - name: wingman_escort
      inputs: [{name: ship, type: entity}, {name: dt, type: number}]
      outputs: [{name: ok, type: boolean}]
      exported: true
      category: Behaviour tree leaves
