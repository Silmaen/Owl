FormatVersion: 1
VisualScript:
  variables:
    - {name: ui_scale_min, type: float, default: 0.75, min: 0.1}
    - {name: ui_scale_max, type: float, default: 2, min: 0.1}
    - {name: toggle_keys, type: strings, default: 'field_easy, field_no_assist, field_invert_y'}
    - {name: toggle_names, type: strings, default: 'STURDY CONVOY, START WITHOUT ASSIST, INVERT PITCH'}
    - {name: sweep, type: color, default: '0.02, 0.02, 0.08, 1'}
    - {name: leaving, type: bool, default: false, exposed: false}
  functions:
    - name: refresh
      inputs: []
      outputs: []
    - name: go_back_now
      inputs: []
      outputs: []
  customNodes:
    - name: next_colour_mode
      title: Next colour mode
      inputs: [{name: mode, type: string}]
      outputs: [{name: next, type: string}]
      pure: true
      code: |
        local modes = { "none", "protanopia", "deuteranopia", "tritanopia" }
        for index, name in ipairs(modes) do
        	if name == mode then
        		return modes[index % #modes + 1]
        	end
        end
        return "none"
