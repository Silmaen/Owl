  - Entity: 7300000386730000088
    Tag:
      tag: HowToControls
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 7300000386730000085
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [0.94, 0.4]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiText:
      outlineWidth: 2
      text: "PITCH, YAW    arrows, A / D, left stick, hold right click: toward the aim\nAIM           mouse (click the view), the X leads a lock\nTHROTTLE      W / S raise / lower (kept), Backspace cuts, RT / LT\nROLL          Q / E, LB / RB\nSLIDE         X / C, R / V, right stick\nFIRE          Space, left click, A\nLOCK TARGET   F, middle click, X     NEXT  wheel, T / G, d-pad\nWINGS ATTACK  1, Y     WINGS ESCORT  2, B\nASSIST        Z, right stick click     PAUSE  Escape, P, Start"
      color: [0.8, 0.6, 1, 1]
      fontSize: 21
      horizontalAlignment: Left
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0.25
      wrap: true
      fit: Shrink
      minFontSize: 12
      font: JetBrainsMono-Regular
  - Entity: 7300000386730000089
    Tag:
      tag: HowToRules
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 7300000386730000085
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [0.94, 0.36]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiText:
      outlineWidth: 2
      text: 'Three freighters fly through the asteroid field to the jump gate; you and two wingmen escort them. Waves of fighters come out of the field for the convoy or for you: shoot them down, lock the one ahead of you to aim at it, and order your wings to attack or to keep their slot. Rocks hurt: fly around them. The mission is won when the convoy jumps, lost when it is destroyed or when your fighter is. Each freighter saved, each kill and the hull left make the score.'
      color: [0.7, 0.85, 0.8, 1]
      fontSize: 22
      horizontalAlignment: Left
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0.2
      wrap: true
      fit: Shrink
      minFontSize: 12
