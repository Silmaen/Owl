@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# EnTT is the only public dependency of Owl::OwlEngine.
find_dependency(EnTT CONFIG)

if (NOT TARGET Owl::OwlEngine)
    include("${CMAKE_CURRENT_LIST_DIR}/OwlEngineTargets.cmake")
endif ()

# Engine modules built into this package (OWL_MODULE_*): find_package(OwlEngine COMPONENTS Physics) fails when the
# package was built without it. The OWL_WITH_<MODULE> definitions of Owl::OwlEngine say the same to the code.
set(OwlEngine_MODULES "@OWL_PACKAGE_MODULES@")
foreach (_owl_module Render Physics Audio Script)
    if (_owl_module IN_LIST OwlEngine_MODULES)
        set(OwlEngine_${_owl_module}_FOUND TRUE)
    else ()
        set(OwlEngine_${_owl_module}_FOUND FALSE)
    endif ()
endforeach ()
unset(_owl_module)

# Optional component Gui (find_package(OwlEngine COMPONENTS Gui)): Owl::Gui, the engine plus imgui, for the
# headers that include imgui (<owlgui.h>, gui/utils.h, gui/widgets/AssetField.h, gui/widgets/CurveEditor.h).
set(OwlEngine_Gui_FOUND FALSE)
if ("Gui" IN_LIST OwlEngine_FIND_COMPONENTS AND "Gui" IN_LIST OwlEngine_MODULES)
    find_package(imgui CONFIG QUIET)
    if (imgui_FOUND)
        if (NOT TARGET Owl::Gui)
            include("${CMAKE_CURRENT_LIST_DIR}/OwlEngineGuiTargets.cmake")
        endif ()
        set(OwlEngine_Gui_FOUND TRUE)
    endif ()
endif ()

check_required_components(OwlEngine)
