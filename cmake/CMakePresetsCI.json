{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "include": [
    "CMakePresetsBase.json",
    "CMakePresetsLinux.json",
    "CMakePresetsMinGW.json"
  ],
  "configurePresets": [
    {
      "name": "linux-clang-tidy",
      "inherits": "linux-clang-debug",
      "cacheVariables": {
        "OWL_BENCHMARK": "OFF",
        "OWL_ENABLE_CLANG_TIDY": "ON",
        "OWL_ENABLE_COVERAGE": "OFF",
        "OWL_ENABLE_STACKTRACE": "OFF",
        "OWL_TESTING": "OFF"
      },
      "vendor": {
        "silmaen": {
          "release_preset": ""
        }
      }
    },
    {
      "name": "windows-clang-tidy",
      "inherits": "windows-clang-debug",
      "cacheVariables": {
        "OWL_ENABLE_CLANG_TIDY": "ON",
        "OWL_ENABLE_COVERAGE": "OFF",
        "OWL_ENABLE_STACKTRACE": "OFF",
        "OWL_TESTING": "OFF"
      },
      "vendor": {
        "silmaen": {
          "release_preset": ""
        }
      }
    },
    {
      "name": "linux-sanitizer-address",
      "inherits": "linux-clang-debug",
      "cacheVariables": {
        "OWL_BENCHMARK": "OFF",
        "OWL_ENABLE_ADDRESS_SANITIZER": "ON",
        "OWL_ENABLE_COVERAGE": "OFF",
        "OWL_ENABLE_STACKTRACE": "ON",
        "OWL_TEST_SHUFFLE": "ON"
      },
      "vendor": {
        "silmaen": {
          "release_preset": ""
        }
      }
    },
    {
      "name": "linux-sanitizer-thread",
      "inherits": "linux-clang-debug",
      "cacheVariables": {
        "OWL_BENCHMARK": "OFF",
        "OWL_ENABLE_THREAD_SANITIZER": "ON",
        "OWL_ENABLE_COVERAGE": "OFF",
        "OWL_ENABLE_STACKTRACE": "ON",
        "OWL_TEST_SHUFFLE": "ON"
      },
      "vendor": {
        "silmaen": {
          "release_preset": ""
        }
      }
    },
    {
      "name": "linux-sanitizer-undefined-behavior",
      "inherits": "linux-clang-debug",
      "cacheVariables": {
        "OWL_BENCHMARK": "OFF",
        "OWL_ENABLE_UNDEFINED_BEHAVIOR_SANITIZER": "ON",
        "OWL_ENABLE_COVERAGE": "OFF",
        "OWL_ENABLE_STACKTRACE": "OFF",
        "OWL_TEST_SHUFFLE": "ON"
      },
      "vendor": {
        "silmaen": {
          "release_preset": ""
        }
      }
    },
    {
      "name": "linux-emulated",
      "inherits": "linux-clang-debug",
      "cacheVariables": {
        "OWL_ENABLE_COVERAGE": "OFF",
        "OWL_ENABLE_DOCUMENTATION": "OFF",
        "OWL_BENCHMARK": "OFF",
        "OWL_RENDER_TESTS": "OFF",
        "OWL_TEST_TIMEOUT": "3600"
      },
      "vendor": {
        "silmaen": {
          "release_preset": ""
        }
      }
    },
    {
      "name": "linux-bench",
      "inherits": "linux-clang-release",
      "cacheVariables": {
        "OWL_BENCHMARK": "ON",
        "OWL_TESTING": "OFF",
        "OWL_BUILD_NEST": "OFF"
      },
      "vendor": {
        "silmaen": {
          "release_preset": ""
        }
      }
    },
    {
      "name": "linux-include-check",
      "inherits": "linux-clang-release",
      "cacheVariables": {
        "OWL_INCLUDE_CHECK": "ON",
        "OWL_BENCHMARK": "ON"
      },
      "vendor": {
        "silmaen": {
          "release_preset": ""
        }
      }
