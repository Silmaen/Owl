{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "include": [
    "CMakePresetsLinux.json"
  ],
  "configurePresets": [
    {
      "name": "package-linux",
      "inherits": [
        "linux-clang-release"
      ],
      "cacheVariables": {
        "OWL_TESTING": "OFF"
      },
      "vendor": {
        "silmaen": {
          "docker_image": "builder-ubuntu2604",
          "package": true,
          "publish_doc": false
        }
      }
    },
    {
      "name": "package-linux-cross-arm64",
      "inherits": [
        "package-linux"
      ],
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-aarch64-clang.cmake",
      "vendor": {
        "silmaen": {
          "docker_image": "builder-cross-arm64-ubuntu2604",
          "package": true,
          "publish_doc": false
        }
      }
    }
  ]
}
