{# Linux, GCC + libstdc++ (the toolchain of the linux-gcc-* presets). #}
{% set compiler, version, compiler_exe = detect_api.detect_gcc_compiler("gcc") %}
[settings]
os=Linux
arch={{ detect_api.detect_arch() }}
compiler=gcc
compiler.version={{ detect_api.default_compiler_version(compiler, version) }}
compiler.libcxx=libstdc++11
compiler.cppstd=23
build_type=Release

[conf]
tools.build:compiler_executables={"c": "gcc", "cpp": "g++"}
tools.cmake.cmaketoolchain:generator=Ninja
tools.system.package_manager:mode=check

[buildenv]
# CMake 4 refuses cmake_minimum_required below 3.5, still declared by some upstream projects.
CMAKE_POLICY_VERSION_MINIMUM=3.5
CC=gcc
CXX=g++

# One version per build tool, the highest the recipes resolve (they each ask their own range).
[replace_tool_requires]
cmake/*: cmake/4.4.3
pkgconf/*: pkgconf/2.5.1
