Scene: Game Over
Entities:
  - Entity: 3000
    Tag:
      tag: GameOverCanvas
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 0
    Canvas:
      space: ScreenOverlay
      sortOrder: 20
      referenceResolution: [1280, 720]
      scaleMode: ScaleWithHeight
  - Entity: 3001
    Tag:
      tag: GameOverTitle
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 3000
    UiRect:
      anchorMin: [0.5, 0.5]
      anchorMax: [0.5, 0.5]
      pivot: [0.5, 0.5]
      size: [400, 60]
      offset: [0, -60]
    UiText:
      text: "Game Over"
      color: [1, 0.3, 0.3, 1]
      fontSize: 48
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0
  - Entity: 3002
    Tag:
      tag: RetryButton
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 3000
    UiRect:
      anchorMin: [0.5, 0.5]
      anchorMax: [0.5, 0.5]
      pivot: [0.5, 0.5]
      size: [180, 45]
      offset: [0, 20]
    UiButton:
      normalColor: [0.3, 0.3, 0.5, 1]
      hoverColor: [0.4, 0.4, 0.6, 1]
      pressedColor: [0.2, 0.2, 0.4, 1]
      disabledColor: [0.15, 0.15, 0.15, 0.5]
      onClickCallback: on_retry_clicked
    UiText:
      text: "Retry"
      color: [1, 1, 1, 1]
      fontSize: 22
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0
  - Entity: 3003
    Tag:
      tag: MainMenuButton
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 3000
    UiRect:
      anchorMin: [0.5, 0.5]
      anchorMax: [0.5, 0.5]
      pivot: [0.5, 0.5]
      size: [180, 45]
      offset: [0, 80]
    UiButton:
      normalColor: [0.3, 0.3, 0.3, 1]
      hoverColor: [0.4, 0.4, 0.4, 1]
      pressedColor: [0.2, 0.2, 0.2, 1]
      disabledColor: [0.15, 0.15, 0.15, 0.5]
      onClickCallback: on_main_menu_clicked
    UiText:
      text: "Main Menu"
      color: [1, 1, 1, 1]
      fontSize: 22
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0
