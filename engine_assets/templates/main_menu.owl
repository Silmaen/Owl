Scene: Main Menu
Entities:
  - Entity: 1000
    Tag:
      tag: UICanvas
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 0
    Canvas:
      space: ScreenOverlay
      sortOrder: 0
      referenceResolution: [1280, 720]
      scaleMode: ScaleWithHeight
  - Entity: 1001
    Tag:
      tag: Title
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 1000
    UiRect:
      anchorMin: [0.5, 0]
      anchorMax: [0.5, 0]
      pivot: [0.5, 0]
      size: [400, 60]
      offset: [0, 80]
    UiText:
      text: "Game Title"
      color: [1, 1, 1, 1]
      fontSize: 48
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0
  - Entity: 1002
    Tag:
      tag: StartButton
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 1000
    UiRect:
      anchorMin: [0.5, 0.5]
      anchorMax: [0.5, 0.5]
      pivot: [0.5, 0.5]
      size: [200, 50]
      offset: [0, -30]
    UiButton:
      normalColor: [0.3, 0.3, 0.3, 1]
      hoverColor: [0.4, 0.4, 0.4, 1]
      pressedColor: [0.2, 0.2, 0.2, 1]
      disabledColor: [0.15, 0.15, 0.15, 0.5]
      onClickCallback: on_start_clicked
    UiText:
      text: "Start"
      color: [1, 1, 1, 1]
      fontSize: 24
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0
  - Entity: 1003
    Tag:
      tag: QuitButton
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 1000
    UiRect:
      anchorMin: [0.5, 0.5]
      anchorMax: [0.5, 0.5]
      pivot: [0.5, 0.5]
      size: [200, 50]
      offset: [0, 40]
    UiButton:
      normalColor: [0.3, 0.3, 0.3, 1]
      hoverColor: [0.4, 0.4, 0.4, 1]
      pressedColor: [0.2, 0.2, 0.2, 1]
      disabledColor: [0.15, 0.15, 0.15, 0.5]
      onClickCallback: on_quit_clicked
    UiText:
      text: "Quit"
      color: [1, 1, 1, 1]
      fontSize: 24
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0
