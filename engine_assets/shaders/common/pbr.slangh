// Shared lighting of the 3D shaders (mesh3d, voxel): the scene, material and lighting blocks, the texture slots,
// the Standard (Filament), Toon and Unlit shading models, the cascaded shadows and the image-based lighting.
// Positions are camera-relative (the eye at the origin, `relativePosition`) and depth is reversed-Z.

struct Scene3D {
	column_major float4x4 viewProjection;
	column_major float4x4 model;
	float4 sunDirection;// xyz: direction the sun of the layer travels; w: its pre-exposed illuminance (0 when unlit).
	float4 ambient;     // rgb: editor ambient added to every lit surface; w: exposure (1 / (1.2 * 2^EV100)).
	float4 tint;        // per-entity colour multiplied with the base colour.
	int4 ids;           // x: entity id (-1 none); y: 1 when the target stores linear colour; z: 1 in a shadow pass; w: first visible instance (-1 for a single draw).
	float4 origin;      // xyz: world position of the eye, origin of the camera-relative space of the shading; w: -1 when the projection winds the faces backwards.
};

struct MaterialData {
	float4 baseColor;  // rgb (sRGB as authored), a.
	float4 emissive;   // rgb emitted colour (sRGB as authored); w: alpha cutoff.
	float4 factors;    // x metallic, y perceptual roughness, z normal scale, w occlusion strength.
	float4 layers;     // x clearcoat, y clearcoat roughness, z anisotropy, w anisotropy rotation (radians).
	float4 sheen;      // rgb sheen colour (sRGB), w sheen roughness.
	int4 model;        // x shading model (0 Standard, 1 Unlit, 2 Toon), y alpha mode (0 Opaque, 1 Mask, 2 Blend), z map mask, w toon bands.
	float4 toon;       // x toon rim strength, y emissive luminance (nits), z IOR, w clearcoat IOR.
	int4 channels;     // channel (0 R, 1 G, 2 B, 3 A) read by the x metallic, y roughness, z occlusion maps; w normal map convention (0 OpenGL, 1 DirectX).
};

struct LightData {
	float4 positionRange;// xyz: camera-relative position (point, spot, centre of an area light); w: range.
	float4 directionType;// xyz: direction the light travels; w: 0 directional, 1 point, 2 spot, 3 rectangle, 4 disc, 5 sphere.
	float4 color;        // rgb: linear colour times illuminance, intensity or luminance (rectangle, disc).
	float4 spotCosines;  // x: cosine of the inner angle, y: of the outer angle, z: local shadow entry (-1 none), w: angular radius.
	float4 area;         // xyz: half width axis (rectangle) or half axis (disc); w: half height (rectangle) or radius.
};

// A matrix array ignores `column_major`: each cascade matrix sits in a struct of its own.
struct CascadeMatrix {
	column_major float4x4 viewProjection;
};

// Shadows of local lights: OpenGL samples 32 textures at most, 2D slots and cubes together.
#ifdef BACKEND_VULKAN
static const int MAX_SPOT_SHADOWS = 16;
static const int MAX_POINT_SHADOWS = 16;
#else
static const int MAX_SPOT_SHADOWS = 4;
static const int MAX_POINT_SHADOWS = 4;
#endif
static const int MAX_LOCAL_SHADOWS = MAX_SPOT_SHADOWS + MAX_POINT_SHADOWS;
static const int SPOT_SHADOW_SLOT = 20;
static const int TEXTURE_SLOT_COUNT = SPOT_SHADOW_SLOT + MAX_SPOT_SHADOWS;
// Point shadow cubes, then as many reflection probes.
static const int CUBE_SLOT_COUNT = 2 * MAX_POINT_SHADOWS;

// The shadow of a spot or point light.
struct LocalShadow {
	column_major float4x4 viewProjection;// spot: camera-relative view-projection of the light camera.
	float4 params;                       // x: 2D slot (spot) or cube index (point), y: resolution, z: bias in texels, w: 1 point, 2 spot.
	float4 depth;                        // xy: depth of a point face (x + y / d), z: tangent of the half angle of the light camera, w: radius of the emitting surface (0 hard).
};

// A local reflection probe: a prefiltered cube of the scene and its axis-aligned volume of influence.
struct ReflectionProbe {
	float4 center;  // xyz: centre relative to the eye, w: 0 box, 1 sphere.
	float4 extents; // xyz: half size of a box, w: radius of a sphere.
	float4 params;  // x: blend distance, y: pre-exposed scale of the radiance, z: prefiltered levels, w: 1 with parallax.
};

static const int MAX_REFLECTION_PROBES = 16;

struct Lighting {
	int4 counts;          // x: light count (0: the sun of the layer), y: shadow cascades, z: index of the shadowed light, w: reflection probes.
	float4 splitDepths;   // view depth where each cascade ends.
	float4 texelSizes;    // world size of a shadow texel, per cascade.
	float4 viewDepthRow;  // view depth of a camera-relative point p: -(dot(xyz, p) + w).
	float4 shadowParams;  // x: normal-offset bias in texels, y: shadow-map size in texels, z: tangent of the angular radius (0 hard).
	float4 environment;   // x intensity, y cos and z sin of the rotation about Y, w number of prefiltered levels (0 none).
	float4 irradiance[9]; // order-2 spherical harmonics of the diffuse irradiance / pi (rgb).
	CascadeMatrix cascades[4];
	float4 skySun;        // xyz: direction towards the sun, w: angular radius of the sun and moon discs (0 none).
	float4 skyBodies;     // pre-exposed radiance: x sun disc, y moon disc, z brightest stars.
	float4 cascadeDepths; // depth each cascade's light camera covers, in world units.
	ReflectionProbe probes[MAX_REFLECTION_PROBES];
	LocalShadow localShadows[MAX_LOCAL_SHADOWS];
};

[[vk::binding(0)]]
ConstantBuffer<Scene3D> gScene;

#ifdef BACKEND_VULKAN
[[vk::binding(1)]]
#else
[[vk::binding(0)]]
#endif
Sampler2D gTextures[TEXTURE_SLOT_COUNT];

// OpenGL binds the cubes to the units that follow the 2D textures.
#ifdef BACKEND_VULKAN
[[vk::binding(7)]]
#else
[[vk::binding(24)]]
#endif
SamplerCube gCubes[CUBE_SLOT_COUNT];

[[vk::binding(2)]]
StructuredBuffer<LightData> gLights;

[[vk::binding(3)]]
ConstantBuffer<Lighting> gLighting;

[[vk::binding(4)]]
ConstantBuffer<MaterialData> gMaterial;

// Position relative to the eye of a vertex under a model matrix: the translation loses the eye before the rotation
// is applied, so a far-away model keeps the precision of a near one.
float3 relativePosition(float4x4 model, float3 position) {
	float3 translation = float3(model[0][3], model[1][3], model[2][3]) - gScene.origin.xyz;
	return mul((float3x3) model, position) + translation;
}

// Texture slots: 0 white, 1-6 material maps, 7-12 prefiltered environment, 13 split-sum table, 14 LTC matrices,
// 15 clipped sphere, 16-19 shadow cascades, 20 onward spot shadows; cubes: point shadows, then reflection probes.
static const int MAP_BASE_COLOR = 1;
static const int MAP_METALLIC = 2;
static const int MAP_NORMAL = 3;
static const int MAP_OCCLUSION = 4;
static const int MAP_EMISSIVE = 5;
static const int MAP_ROUGHNESS = 6;
static const int DFG_SLOT = 13;
static const int LTC_SLOT = 14;
static const int CLIPPED_SPHERE_SLOT = 15;
static const float LTC_SIZE = 64.0f;
static const int ENVIRONMENT_SLOT = 7;
static const int MAX_ENVIRONMENT_LEVELS = 6;
static const int SHADOW_MAP_SLOT = 16;

static const float PI = 3.14159265359f;
static const float MIN_ROUGHNESS = 0.045f;

// Exact piecewise sRGB decode, used when the target stores linear colour.
float3 srgbToLinear(float3 c) {
	return select(c <= 0.04045f, c / 12.92f, pow((c + 0.055f) / 1.055f, 2.4f));
}

// An authored sRGB colour as the target expects it (decoded on a linear target only).
float3 authoredColor(float3 c) {
	return gScene.ids.y != 0 ? srgbToLinear(c) : c;
}

bool hasMap(int bit) {
	return (gMaterial.model.z & (1 << bit)) != 0;
}

// Reflectance at normal incidence of a dielectric of this index of refraction (0.04 at 1.5).
float iorToF0(float ior) {
	float r = (ior - 1.0f) / (ior + 1.0f);
	return r * r;
}

// One channel (0 R, 1 G, 2 B, 3 A) of a material map.
float sampleChannel(int slot, float2 uv, int channel) {
	float4 texel = gTextures[slot].Sample(uv);
	return channel == 0 ? texel.r : channel == 1 ? texel.g : channel == 2 ? texel.b : texel.a;
}

// ------------------------------------------------------------------ shadows

// Depth stored in a texel of a cascade's shadow map, sampled at its centre (nearest sampler): a texel fetch from
// the texture array crashes lavapipe.
float loadShadowDepth(int slot, int2 texel, float size) {
	return gTextures[NonUniformResourceIndex(slot)].SampleLevel((float2(texel) + 0.5f) / size, 0.0f).r;
}

// Poisson disc of the soft shadows, in a unit circle.
static const float2 POISSON_DISC[16] = {
	float2(-0.9420f, -0.3991f), float2(0.9456f, -0.7689f), float2(-0.0942f, -0.9294f), float2(0.3450f, 0.2939f),
	float2(-0.9159f, 0.4577f),  float2(-0.8154f, -0.8791f), float2(-0.3828f, 0.2768f), float2(0.9748f, 0.7565f),
	float2(0.4432f, -0.9751f),  float2(0.5374f, -0.4737f), float2(-0.2650f, -0.4189f), float2(0.7920f, 0.1909f),
	float2(-0.2419f, 0.9971f),  float2(-0.8141f, 0.9144f), float2(0.1998f, 0.7864f),  float2(0.1438f, -0.1410f)
};
// Widest penumbra of a soft shadow, in shadow-map texels.
static const float MAX_PENUMBRA_TEXELS = 16.0f;

// Soft shadow of an orthographic map (PCSS): the blockers found within the cone of the light set the width of the
// filter, so the penumbra grows with the distance between a caster and its receiver. 1 when lit, 0 in shadow.
float softShadowFactor(int slot, float2 uv, float depth, int size, float texelWorld, float depthRange, float tanRadius) {
	float receiverDistance = (1.0f - depth) * depthRange;
	float searchTexels = clamp(2.0f * tanRadius * receiverDistance / texelWorld, 1.0f, MAX_PENUMBRA_TEXELS);
	float2 centre = uv * float(size);
	// The disc turns with the shadow-map texel (interleaved gradient noise): no banding, and still in the world.
	float angle = 6.2831853f * frac(52.9829189f * frac(dot(floor(centre), float2(0.06711056f, 0.00583715f))));
	float2x2 turn = float2x2(cos(angle), -sin(angle), sin(angle), cos(angle));
	float blockerSum = 0.0f;
	float blockers = 0.0f;
	for (int index = 0; index < 16; ++index) {
		int2 tap = clamp(int2(centre + mul(turn, POISSON_DISC[index]) * searchTexels), int2(0), int2(size - 1));
		float stored = loadShadowDepth(slot, tap, float(size));
		if (stored > depth + 0.0005f) {
			blockerSum += stored;
			blockers += 1.0f;
		}
	}
	if (blockers == 0.0f)
		return 1.0f;
	float blockerDepth = blockerSum / blockers;
	float penumbra = 2.0f * tanRadius * (blockerDepth - depth) * depthRange / texelWorld;
	float filterTexels = clamp(penumbra, 1.0f, MAX_PENUMBRA_TEXELS);
	float lit = 0.0f;
	for (int index = 0; index < 16; ++index) {
		int2 tap = clamp(int2(centre + mul(turn, POISSON_DISC[index]) * filterTexels), int2(0), int2(size - 1));
		lit += depth >= loadShadowDepth(slot, tap, float(size)) - 0.0005f ? 1.0f : 0.0f;
	}
	return lit / 16.0f;
}

// 1 when lit, 0 in shadow: 3x3 comparisons in the cascade covering the point (reversed-Z: larger is nearer).
float shadowFactor(float3 position, float3 normal) {
	float depth = -(dot(gLighting.viewDepthRow.xyz, position) + gLighting.viewDepthRow.w);
	int cascade = 0;
	while (cascade < gLighting.counts.y && depth > gLighting.splitDepths[cascade])
		cascade++;
	if (cascade >= gLighting.counts.y)
		return 1.0f;
	float3 offsetPos = position + normal * (gLighting.texelSizes[cascade] * gLighting.shadowParams.x);
	float4 clip = mul(gLighting.cascades[cascade].viewProjection, float4(offsetPos, 1.0f));
	float3 ndc = clip.xyz / clip.w;
	float2 uv = ndc.xy * 0.5f + 0.5f;
	if (any(uv < 0.0f) || any(uv > 1.0f) || ndc.z < 0.0f)
		return 1.0f;
	int size = int(gLighting.shadowParams.y);
	if (gLighting.shadowParams.z > 0.0f)
		return softShadowFactor(SHADOW_MAP_SLOT + cascade, uv, ndc.z, size, gLighting.texelSizes[cascade],
								gLighting.cascadeDepths[cascade], gLighting.shadowParams.z);
	int2 texel = int2(uv * float(size));
	float lit = 0.0f;
	for (int dy = -1; dy <= 1; ++dy) {
		for (int dx = -1; dx <= 1; ++dx) {
			int2 tap = clamp(texel + int2(dx, dy), int2(0), int2(size - 1));
			lit += ndc.z >= loadShadowDepth(SHADOW_MAP_SLOT + cascade, tap, float(size)) - 0.0005f ? 1.0f : 0.0f;
		}
	}
	return lit / 9.0f;
}

// Reversed-Z perspective depth is not linear: the comparison tolerance is a fraction of the stored depth.
static const float LOCAL_SHADOW_TOLERANCE = 0.998f;

// 1 when lit, 0 in shadow: 3x3 comparisons in the 2D map of a spot light.
float spotShadowFactor(LocalShadow shadow, float3 position) {
	float4 clip = mul(shadow.viewProjection, float4(position, 1.0f));
	if (clip.w <= 0.0f)
		return 1.0f;
	float3 ndc = clip.xyz / clip.w;
	float2 uv = ndc.xy * 0.5f + 0.5f;
	if (any(uv < 0.0f) || any(uv > 1.0f) || ndc.z < 0.0f)
		return 1.0f;
	int size = int(shadow.params.y);
	int slot = int(shadow.params.x);
	int2 texel = int2(uv * float(size));
	float lit = 0.0f;
	for (int dy = -1; dy <= 1; ++dy) {
		for (int dx = -1; dx <= 1; ++dx) {
			int2 tap = clamp(texel + int2(dx, dy), int2(0), int2(size - 1));
			lit += ndc.z >= loadShadowDepth(slot, tap, float(size)) * LOCAL_SHADOW_TOLERANCE ? 1.0f : 0.0f;
		}
	}
	return lit / 9.0f;
}

// Soft shadow of an area light in its cube (PCSS): the blockers found towards the emitting surface set the width of
// the filter, measured at the receiver, so the penumbra grows with the distance between a caster and its receiver.
float softPointShadowFactor(LocalShadow shadow, float3 fromLight, float3 u, float3 v, float major, float reference) {
	int cube = int(shadow.params.x);
	float texel = 2.0f * major / shadow.params.y;
	float lightSize = shadow.depth.w;
	float searchWidth = clamp(lightSize, texel, MAX_PENUMBRA_TEXELS * texel);
	float3 cell = floor(fromLight / texel);
	float angle = 6.2831853f * frac(52.9829189f * frac(dot(cell, float3(0.06711056f, 0.00583715f, 0.0293f))));
	float2x2 turn = float2x2(cos(angle), -sin(angle), sin(angle), cos(angle));
	// A bound the compiler cannot fold keeps the cube taps rolled: unrolled, they cost llvmpipe seconds of compilation.
	int taps = 16 + min(cube, 0);
	float blockerSum = 0.0f;
	float blockers = 0.0f;
	for (int index = 0; index < taps; ++index) {
		float2 offset = mul(turn, POISSON_DISC[index]) * searchWidth;
		float stored = gCubes[NonUniformResourceIndex(cube)].SampleLevel(fromLight + u * offset.x + v * offset.y, 0.0f).r;
		if (reference < stored * LOCAL_SHADOW_TOLERANCE) {
			// Distance of the blocker along the axis of the face: depth = x + y / d.
			blockerSum += shadow.depth.y / max(stored - shadow.depth.x, 1e-6f);
			blockers += 1.0f;
		}
	}
	if (blockers == 0.0f)
		return 1.0f;
	float blockerDistance = min(blockerSum / blockers, major);
	float penumbra = lightSize * (major - blockerDistance) / max(blockerDistance, 1e-3f);
	float filterWidth = clamp(penumbra, texel, MAX_PENUMBRA_TEXELS * texel);
	float lit = 0.0f;
	for (int index = 0; index < taps; ++index) {
		float2 offset = mul(turn, POISSON_DISC[index]) * filterWidth;
		float stored = gCubes[NonUniformResourceIndex(cube)].SampleLevel(fromLight + u * offset.x + v * offset.y, 0.0f).r;
		lit += reference >= stored * LOCAL_SHADOW_TOLERANCE ? 1.0f : 0.0f;
	}
	return lit / float(taps);
}

// 1 when lit, 0 in shadow: 3x3 comparisons around the direction from a point light, in its cube.
float pointShadowFactor(LocalShadow shadow, float3 fromLight) {
	float3 axis = abs(fromLight);
	float major = max(axis.x, max(axis.y, axis.z));
	if (major <= 0.0f)
		return 1.0f;
	float reference = shadow.depth.x + shadow.depth.y / major;
	// Two directions across the face holding the ray, one texel of the face apart.
	float3 across = axis.x >= axis.y && axis.x >= axis.z ? float3(0.0f, 1.0f, 0.0f) : float3(1.0f, 0.0f, 0.0f);
	float3 u = normalize(cross(fromLight, across));
	float3 v = cross(normalize(fromLight), u);
	if (shadow.depth.w > 0.0f)
		return softPointShadowFactor(shadow, fromLight, u, v, major, reference);
	float step = 2.0f * major / shadow.params.y;
	int cube = int(shadow.params.x);
	float lit = 0.0f;
	for (int dy = -1; dy <= 1; ++dy) {
		for (int dx = -1; dx <= 1; ++dx) {
			float3 tap = fromLight + (u * float(dx) + v * float(dy)) * step;
			float stored = gCubes[NonUniformResourceIndex(cube)].SampleLevel(tap, 0.0f).r;
			lit += reference >= stored * LOCAL_SHADOW_TOLERANCE ? 1.0f : 0.0f;
		}
	}
	return lit / 9.0f;
}

// Shadow of a point or spot light on a surface point, offset along the normal by the world size of a shadow texel.
float localShadowFactor(int entry, float3 position, float3 normal, float3 lightPosition) {
	LocalShadow shadow = gLighting.localShadows[entry];
	float texel = 2.0f * length(position - lightPosition) * shadow.depth.z / shadow.params.y;
	float3 offsetPos = position + normal * (texel * shadow.params.z);
	if (int(shadow.params.w) == 2)
		return spotShadowFactor(shadow, offsetPos);
	return pointShadowFactor(shadow, offsetPos - lightPosition);
}

// ------------------------------------------------------------------ surface

// Everything the shading models need about the shaded point.
struct Surface {
	float3 position;
	float3 normal;        // shading normal (normal map applied), unit.
	float3 tangent;       // anisotropy direction, unit, in the tangent plane.
	float3 bitangent;
	float3 view;          // unit vector towards the eye.
	float3 albedo;        // linear base colour.
	float alpha;
	float metallic;
	float roughness;      // perceptual, clamped.
	float occlusion;
	float3 emissive;      // linear.
	float clearcoat;
	float clearcoatRoughness;
	float3 sheenColor;    // linear.
	float sheenRoughness;
	float anisotropy;
};

// Cotangent frame from the screen-space derivatives of the position and the UV (no tangent in the vertex layout).
float3x3 cotangentFrame(float3 normal, float3 position, float2 uv) {
	float3 dp1 = ddx(position);
	float3 dp2 = ddy(position);
	float2 duv1 = ddx(uv);
	float2 duv2 = ddy(uv);
	float3 dp2perp = cross(dp2, normal);
	float3 dp1perp = cross(normal, dp1);
	float3 t = dp2perp * duv1.x + dp1perp * duv2.x;
	float3 b = dp2perp * duv1.y + dp1perp * duv2.y;
	// The frame follows the handedness of the screen axes: Vulkan's y-down derivatives would mirror the relief.
	float handedness = dot(cross(dp1, dp2), normal) < 0.0f ? -1.0f : 1.0f;
	float invmax = handedness * rsqrt(max(max(dot(t, t), dot(b, b)), 1e-20f));
	return float3x3(t * invmax, b * invmax, normal);
}

// ------------------------------------------------------------------ BRDF (Filament)

float D_GGX(float NoH, float a) {
	float a2 = a * a;
	float f = (NoH * a2 - NoH) * NoH + 1.0f;
	return a2 / (PI * f * f + 1e-7f);
}

float V_SmithGGXCorrelated(float NoV, float NoL, float a) {
	float a2 = a * a;
	float lambdaV = NoL * sqrt((NoV - a2 * NoV) * NoV + a2);
	float lambdaL = NoV * sqrt((NoL - a2 * NoL) * NoL + a2);
	return 0.5f / (lambdaV + lambdaL + 1e-7f);
}

float D_GGX_Anisotropic(float NoH, float3 h, float3 t, float3 b, float at, float ab) {
	float ToH = dot(t, h);
	float BoH = dot(b, h);
	float a2 = at * ab;
	float3 v = float3(ab * ToH, at * BoH, a2 * NoH);
	float v2 = dot(v, v);
	float w2 = a2 / max(v2, 1e-7f);
	return a2 * w2 * w2 * (1.0f / PI);
}

float V_SmithGGXCorrelated_Anisotropic(float at, float ab, float ToV, float BoV, float ToL, float BoL, float NoV, float NoL) {
	float lambdaV = NoL * length(float3(at * ToV, ab * BoV, NoV));
	float lambdaL = NoV * length(float3(at * ToL, ab * BoL, NoL));
	return 0.5f / (lambdaV + lambdaL + 1e-7f);
}

float3 F_Schlick(float3 f0, float VoH) {
	float f = pow(1.0f - VoH, 5.0f);
	return f + f0 * (1.0f - f);
}

float F_Schlick90(float f0, float f90, float VoH) {
	return f0 + (f90 - f0) * pow(1.0f - VoH, 5.0f);
}

float Fd_Burley(float NoV, float NoL, float LoH, float roughness) {
	float f90 = 0.5f + 2.0f * roughness * LoH * LoH;
	return F_Schlick90(1.0f, f90, NoL) * F_Schlick90(1.0f, f90, NoV) * (1.0f / PI);
}

float V_Kelemen(float LoH) {
	return 0.25f / max(LoH * LoH, 1e-4f);
}

float D_Charlie(float roughness, float NoH) {
	float invAlpha = 1.0f / max(roughness * roughness, 0.0078f);
	float sin2h = max(1.0f - NoH * NoH, 0.0078125f);
	return (2.0f + invAlpha) * pow(sin2h, invAlpha * 0.5f) / (2.0f * PI);
}

float V_Neubelt(float NoV, float NoL) {
	return 1.0f / (4.0f * (NoL + NoV - NoL * NoV) + 1e-7f);
}

// Split-sum table: x DFG scale, y DFG bias, z sheen albedo.
float3 dfgTerms(float NoV, float roughness) {
	// Kept inside the edge texels: the sampler repeats.
	float2 uv = clamp(float2(NoV, roughness), 1.0f / 128.0f, 1.0f - 1.0f / 128.0f);
	return gTextures[DFG_SLOT].SampleLevel(uv, 0.0f).rgb;
}

// Light reflected towards the eye for the Standard model: the diffuse lobe from `diffuseLight`, the specular ones from
// `specularLight` (the representative point of a sphere light, the light direction otherwise).
// Lobe of a light of angular radius `sourceRadius` (radians, 0 for a point): its distribution widened and renormalised
// so the highlight of a disc light grows without gaining energy (Karis, representative roughness); isotropic lobes only.
float3 standardLobeSplit(Surface s, float3 diffuseLight, float3 l, float3 f0, float3 dfg, float sourceRadius) {
	float3 h = normalize(s.view + l);
	float NoV = max(dot(s.normal, s.view), 1e-4f);
	float NoL = saturate(dot(s.normal, l));
	float NoH = saturate(dot(s.normal, h));
	float LoH = saturate(dot(l, h));
	float diffuseNoL = saturate(dot(s.normal, diffuseLight));
	float diffuseLoH = saturate(dot(diffuseLight, normalize(s.view + diffuseLight)));
	float a = s.roughness * s.roughness;
	float D;
	float V;
	if (abs(s.anisotropy) > 1e-3f) {
		float at = max(a * (1.0f + s.anisotropy), 1e-3f);
		float ab = max(a * (1.0f - s.anisotropy), 1e-3f);
		D = D_GGX_Anisotropic(NoH, h, s.tangent, s.bitangent, at, ab);
		V = V_SmithGGXCorrelated_Anisotropic(at, ab, dot(s.tangent, s.view), dot(s.bitangent, s.view),
											  dot(s.tangent, l), dot(s.bitangent, l), NoV, NoL);
	} else {
		D = D_GGX(NoH, a);
		V = V_SmithGGXCorrelated(NoV, NoL, a);
	}
	if (sourceRadius > 0.0f && abs(s.anisotropy) <= 1e-3f) {
		float wide = saturate(a + 0.5f * sin(sourceRadius));
		float normalisation = a / wide;
		D = D_GGX(NoH, wide) * normalisation * normalisation;
	}
	float3 F = F_Schlick(f0, LoH);
	// Multiple-scattering compensation: the single-scattering lobe loses energy on rough surfaces.
	float3 energy = 1.0f + f0 * (1.0f / max(dfg.x + dfg.y, 1e-4f) - 1.0f);
	float3 Fr = D * V * F * energy;
	float3 Fd = s.albedo * (1.0f - s.metallic) * Fd_Burley(NoV, diffuseNoL, diffuseLoH, s.roughness);
	float3 color = Fd * diffuseNoL + Fr * NoL;
	if (any(s.sheenColor > 0.0f)) {
		float sheenScaling = 1.0f - max(s.sheenColor.r, max(s.sheenColor.g, s.sheenColor.b)) * dfg.z;
		color = color * sheenScaling + s.sheenColor * D_Charlie(s.sheenRoughness, NoH) * V_Neubelt(NoV, NoL) * NoL;
	}
	if (s.clearcoat > 0.0f) {
		float ac = max(s.clearcoatRoughness, MIN_ROUGHNESS);
		ac *= ac;
		float Fc = F_Schlick90(iorToF0(gMaterial.toon.w), 1.0f, LoH) * s.clearcoat;
		color = color * (1.0f - Fc) + D_GGX(NoH, ac) * V_Kelemen(LoH) * Fc * NoL;
	}
	return color;
}

float3 standardLobe(Surface s, float3 l, float3 f0, float3 dfg, float sourceRadius) {
	return standardLobeSplit(s, l, l, f0, dfg, sourceRadius);
}

// The Toon model: banded diffuse, a stepped highlight.
float3 toonLobe(Surface s, float3 l) {
	float NoL = saturate(dot(s.normal, l));
	float bands = max(float(gMaterial.model.w), 1.0f);
	float banded = ceil(NoL * bands) / bands;
	float3 h = normalize(s.view + l);
	float highlight = step(1.0f - 0.25f * (1.0f - s.roughness) * (1.0f - s.roughness), saturate(dot(s.normal, h)));
	return s.albedo * banded + highlight * lerp(float3(0.04f), s.albedo, s.metallic) * (1.0f - s.roughness);
}

// ------------------------------------------------------------------ image-based lighting

float3 rotateEnvironment(float3 d) {
	float c = gLighting.environment.y;
	float sn = gLighting.environment.z;
	return float3(c * d.x - sn * d.z, d.y, sn * d.x + c * d.z);
}

float2 equirectangularUv(float3 d) {
	return float2(0.5f + atan2(d.x, -d.z) / (2.0f * PI), acos(clamp(d.y, -1.0f, 1.0f)) / PI);
}

float3 sampleEnvironmentLevel(int level, float2 uv) {
	switch (level) {
		case 0:
			return gTextures[ENVIRONMENT_SLOT].SampleLevel(uv, 0.0f).rgb;
		case 1:
			return gTextures[ENVIRONMENT_SLOT + 1].SampleLevel(uv, 0.0f).rgb;
		case 2:
			return gTextures[ENVIRONMENT_SLOT + 2].SampleLevel(uv, 0.0f).rgb;
		case 3:
			return gTextures[ENVIRONMENT_SLOT + 3].SampleLevel(uv, 0.0f).rgb;
		case 4:
			return gTextures[ENVIRONMENT_SLOT + 4].SampleLevel(uv, 0.0f).rgb;
		default:
			return gTextures[ENVIRONMENT_SLOT + 5].SampleLevel(uv, 0.0f).rgb;
	}
}

float3 irradianceSH(float3 n) {
	float3 d = rotateEnvironment(n);
	float3 r = gLighting.irradiance[0].rgb;
	r += gLighting.irradiance[1].rgb * d.z + gLighting.irradiance[2].rgb * d.y + gLighting.irradiance[3].rgb * d.x;
	r += gLighting.irradiance[4].rgb * (d.x * d.z) + gLighting.irradiance[5].rgb * (d.z * d.y);
	r += gLighting.irradiance[6].rgb * (3.0f * d.y * d.y - 1.0f) + gLighting.irradiance[7].rgb * (d.x * d.y);
	r += gLighting.irradiance[8].rgb * (d.x * d.x - d.z * d.z);
	return max(r, 0.0f);
}

// Radiance prefiltered for a roughness around a reflected direction.
float3 prefilteredRadiance(float3 r, float roughness) {
	float levels = gLighting.environment.w;
	if (levels < 1.0f)
		return irradianceSH(r);
	float2 uv = equirectangularUv(rotateEnvironment(r));
	float lod = roughness * (levels - 1.0f);
	int low = int(floor(lod));
	int high = min(low + 1, int(levels) - 1);
	return lerp(sampleEnvironmentLevel(low, uv), sampleEnvironmentLevel(high, uv), lod - float(low));
}

// Influence of a probe at a point: 1 inside its volume, fading to 0 over the blend distance from its border.
float probeInfluence(ReflectionProbe probe, float3 position) {
	float3 offset = position - probe.center.xyz;
	float inside = probe.center.w > 0.5f ? probe.extents.w - length(offset) : min(min(probe.extents.x - abs(offset.x),
		probe.extents.y - abs(offset.y)), probe.extents.z - abs(offset.z));
	if (inside <= 0.0f)
		return 0.0f;
	return probe.params.x > 0.0f ? saturate(inside / probe.params.x) : 1.0f;
}

// Direction a probe is looked up along for a ray from a point: the ray projected on the volume with parallax.
float3 probeDirection(ReflectionProbe probe, float3 position, float3 r) {
	if (probe.params.w < 0.5f)
		return r;
	float3 offset = position - probe.center.xyz;
	float distance;
	if (probe.center.w > 0.5f) {
		float b = dot(offset, r);
		float c = dot(offset, offset) - probe.extents.w * probe.extents.w;
		distance = -b + sqrt(max(b * b - c, 0.0f));
	} else {
		float3 safe = select(abs(r) < 1e-6f, float3(1e-6f), r);
		float3 far = max((probe.extents.xyz - offset) / safe, (-probe.extents.xyz - offset) / safe);
		distance = min(min(far.x, far.y), far.z);
	}
	return offset + r * max(distance, 0.0f);
}

// Pre-exposed specular radiance around a reflected direction: the two probes of largest influence at the point, the
// prefiltered environment for what they leave.
float3 ambientSpecular(float3 position, float3 r, float roughness) {
	float3 environment = prefilteredRadiance(r, roughness) * gLighting.environment.x;
	int count = min(gLighting.counts.w, MAX_POINT_SHADOWS);
	if (count <= 0)
		return environment;
	int first = -1;
	int second = -1;
	float firstWeight = 0.0f;
	float secondWeight = 0.0f;
	for (int index = 0; index < count; ++index) {
		float weight = probeInfluence(gLighting.probes[index], position);
		if (weight > firstWeight) {
			second = first;
			secondWeight = firstWeight;
			first = index;
			firstWeight = weight;
		} else if (weight > secondWeight) {
			second = index;
			secondWeight = weight;
		}
	}
	if (first < 0)
		return environment;
	float total = firstWeight + secondWeight;
	float scale = total > 1.0f ? 1.0f / total : 1.0f;
	float3 color = environment * max(1.0f - total, 0.0f);
	for (int pick = 0; pick < 2; ++pick) {
		int index = pick == 0 ? first : second;
		if (index < 0)
			continue;
		ReflectionProbe probe = gLighting.probes[index];
		float lod = roughness * max(probe.params.z - 1.0f, 0.0f);
		float3 direction = probeDirection(probe, position, r);
		float3 radiance = gCubes[NonUniformResourceIndex(MAX_POINT_SHADOWS + index)].SampleLevel(direction, lod).rgb;
		color += radiance * probe.params.y * (pick == 0 ? firstWeight : secondWeight) * scale;
	}
	return color;
}

// Ambient light of the Standard model: diffuse from the harmonics, specular from the probes and the prefiltered
// environment.
float3 standardAmbient(Surface s, float3 f0, float3 dfg) {
	float NoV = max(dot(s.normal, s.view), 1e-4f);
	float3 r = reflect(-s.view, s.normal);
	if (abs(s.anisotropy) > 1e-3f) {
		// Bent reflection for an anisotropic lobe.
		float3 anisotropicDirection = s.anisotropy >= 0.0f ? s.bitangent : s.tangent;
		float3 anisotropicTangent = cross(anisotropicDirection, s.view);
		float3 anisotropicNormal = cross(anisotropicTangent, anisotropicDirection);
		float3 bent = normalize(lerp(s.normal, anisotropicNormal, abs(s.anisotropy)));
		r = reflect(-s.view, bent);
	}
	float3 specularColor = dfg.x * f0 + dfg.y;
	float3 energy = 1.0f + f0 * (1.0f / max(dfg.x + dfg.y, 1e-4f) - 1.0f);
	float3 specular = ambientSpecular(s.position, r, s.roughness) * specularColor * energy;
	float3 diffuse = irradianceSH(s.normal) * s.albedo * (1.0f - s.metallic) * gLighting.environment.x;
	float3 color = diffuse + specular;
	if (any(s.sheenColor > 0.0f))
		color = color * (1.0f - max(s.sheenColor.r, max(s.sheenColor.g, s.sheenColor.b)) * dfg.z) +
				s.sheenColor * prefilteredRadiance(s.normal, s.sheenRoughness) * gLighting.environment.x * dfg.z;
	if (s.clearcoat > 0.0f) {
		float Fc = F_Schlick90(iorToF0(gMaterial.toon.w), 1.0f, NoV) * s.clearcoat;
		color = color * (1.0f - Fc) + ambientSpecular(s.position, reflect(-s.view, s.normal), s.clearcoatRoughness) * Fc;
	}
	return color * s.occlusion;
}

// ------------------------------------------------------------------ lights

// Shadow of a light on a surface point, 1 when it casts none: a single call site keeps the sampling inlined once.
float lightShadow(int index, float3 position, float3 normal) {
	LightData light = gLights[index];
	if (int(light.directionType.w) == 0)
		return index == gLighting.counts.z ? shadowFactor(position, normal) : 1.0f;
	int entry = int(light.spotCosines.z);
	if (entry < 0 || entry >= MAX_LOCAL_SHADOWS || length(light.positionRange.xyz - position) >= light.positionRange.w)
		return 1.0f;
	return localShadowFactor(entry, position, normal, light.positionRange.xyz);
}

// Pre-exposed illuminance a light gives a surface (lux for a directional light, intensity / d² otherwise).
void lightIncidence(int index, float3 position, out float3 toLight, out float3 illuminance) {
	LightData light = gLights[index];
	int type = int(light.directionType.w);
	float attenuation = 1.0f;
	if (type == 0) {
		toLight = -light.directionType.xyz;
	} else {
		float3 delta = light.positionRange.xyz - position;
		float dist = length(delta);
		toLight = delta / max(dist, 1e-4f);
		float ratio = dist / max(light.positionRange.w, 1e-4f);
		float window = saturate(1.0f - ratio * ratio * ratio * ratio);
		// Inverse-square falloff of the luminous intensity, cut off smoothly at the range; 1 cm keeps it finite.
		attenuation = window * window / max(dist * dist, 1e-4f);
		if (type == 2)
			attenuation *= smoothstep(light.spotCosines.y, light.spotCosines.x, dot(-toLight, light.directionType.xyz));
	}
	illuminance = light.color.rgb * attenuation;
}

// ------------------------------------------------------------------ area lights (linearly transformed cosines)

// Texel centres of the area tables: coordinate i / (size - 1) of texel i.
float2 ltcUv(float2 coordinates) {
	return coordinates * ((LTC_SIZE - 1.0f) / LTC_SIZE) + 0.5f / LTC_SIZE;
}

// Inverse matrix of the cosine standing for the GGX lobe, in the frame of the view (X towards it, Z the normal).
float3x3 ltcInverse(float roughness, float NoV) {
	float4 t = gTextures[LTC_SLOT].SampleLevel(ltcUv(float2(roughness, sqrt(1.0f - NoV))), 0.0f);
	return float3x3(float3(t.x, 0.0f, t.z), float3(0.0f, 1.0f, 0.0f), float3(t.y, 0.0f, t.w));
}

// Form factor above the horizon of a light given its vector form factor, through the table of the clipped sphere.
float clippedFormFactor(float3 formFactor) {
	float len = length(formFactor);
	if (len <= 1e-6f)
		return 0.0f;
	float2 uv = ltcUv(float2(formFactor.z / len * 0.5f + 0.5f, saturate(len)));
	return len * gTextures[CLIPPED_SPHERE_SLOT].SampleLevel(uv, 0.0f).r;
}

// Part of the vector form factor of a polygon of unit directions brought by one of its edges.
float3 edgeFormFactor(float3 a, float3 b) {
	float x = clamp(dot(a, b), -0.9999f, 0.9999f);
	return cross(a, b) * (acos(x) / sqrt(1.0f - x * x));
}

// Form factor of a rectangle (corners relative to the shaded point, counter-clockwise seen from the lit side) through
// a cosine.
float rectangleFormFactor(float3x3 inverseCosine, float3 corners[4]) {
	float3 l0 = normalize(mul(inverseCosine, corners[0]));
	float3 l1 = normalize(mul(inverseCosine, corners[1]));
	float3 l2 = normalize(mul(inverseCosine, corners[2]));
	float3 l3 = normalize(mul(inverseCosine, corners[3]));
	float3 formFactor = edgeFormFactor(l0, l1) + edgeFormFactor(l1, l2) + edgeFormFactor(l2, l3) + edgeFormFactor(l3, l0);
	return clippedFormFactor(formFactor / (2.0f * PI));
}

// Sides of the polygon standing for a disc, and the scale of its vertices that keeps the area of the disc.
static const int DISC_SIDES = 12;
static const float DISC_SCALE = 1.0233267f;

// Form factor of a disc (centre and two perpendicular half axes relative to the shaded point, the second one a
// quarter turn counter-clockwise from the first seen from the lit side) through a cosine: a polygon of the same area,
// integrated edge by edge like a rectangle.
float discFormFactor(float3x3 inverseCosine, float3 centre, float3 axisU, float3 axisV) {
	float3 first = normalize(mul(inverseCosine, centre + axisU * DISC_SCALE));
	float3 previous = first;
	float3 formFactor = float3(0.0f);
	for (int side = 1; side < DISC_SIDES; ++side) {
		float angle = 6.2831853f * float(side) / float(DISC_SIDES);
		float3 corner = centre + (axisU * cos(angle) + axisV * sin(angle)) * DISC_SCALE;
		float3 current = normalize(mul(inverseCosine, corner));
		formFactor += edgeFormFactor(previous, current);
		previous = current;
	}
	formFactor += edgeFormFactor(previous, first);
	return clippedFormFactor(formFactor / (2.0f * PI));
}

// Light of a rectangle or a disc on a surface: its diffuse and specular lobes integrated over its face. The base layer
// only (no sheen, clearcoat nor anisotropy), the Toon model takes the diffuse part.
float3 areaLightColor(Surface s, int index, float3 f0, float3 dfg, int shadingModel, float shadow) {
	LightData light = gLights[index];
	float3 centre = light.positionRange.xyz - s.position;
	float3 forward = light.directionType.xyz;
	// One-sided: nothing reaches a point behind the emitting face.
	if (dot(centre, forward) >= 0.0f)
		return float3(0.0f);
	float ratio = length(centre) / max(light.positionRange.w, 1e-4f);
	float window = saturate(1.0f - ratio * ratio * ratio * ratio);
	float attenuation = window * window * shadow;
	if (attenuation <= 0.0f)
		return float3(0.0f);
	float NoV = max(dot(s.normal, s.view), 1e-4f);
	float3 t1 = s.view - s.normal * dot(s.view, s.normal);
	if (dot(t1, t1) < 1e-8f)
		t1 = cross(s.normal, abs(s.normal.x) < 0.9f ? float3(1.0f, 0.0f, 0.0f) : float3(0.0f, 1.0f, 0.0f));
	t1 = normalize(t1);
	float3x3 frame = float3x3(t1, cross(s.normal, t1), s.normal);
	float3x3 cosine = float3x3(float3(1.0f, 0.0f, 0.0f), float3(0.0f, 1.0f, 0.0f), float3(0.0f, 0.0f, 1.0f));
	float3x3 specularCosine = ltcInverse(s.roughness, NoV);
	float3 c = mul(frame, centre);
	float3 u = mul(frame, light.area.xyz);
	float3 v = mul(frame, normalize(cross(light.area.xyz, forward)) * light.area.w);
	float diffuse;
	float specular;
	if (int(light.directionType.w) == 3) {
		float3 corners[4] = {c + u + v, c - u + v, c - u - v, c + u - v};
		diffuse = rectangleFormFactor(cosine, corners);
		specular = rectangleFormFactor(specularCosine, corners);
	} else {
		diffuse = discFormFactor(cosine, c, u, v);
		specular = discFormFactor(specularCosine, c, u, v);
	}
	float3 radiance = light.color.rgb * attenuation;
	if (shadingModel == 2)
		return radiance * s.albedo * diffuse;
	float3 energy = 1.0f + f0 * (1.0f / max(dfg.x + dfg.y, 1e-4f) - 1.0f);
	return radiance * (s.albedo * (1.0f - s.metallic) * diffuse + (f0 * dfg.x + dfg.y) * energy * specular);
}

// Direction towards the point of a sphere light nearest to the reflected ray (Karis, representative point).
float3 sphereSpecularDirection(Surface s, float3 toCentre, float radius) {
	float3 r = reflect(-s.view, s.normal);
	float3 centreToRay = dot(toCentre, r) * r - toCentre;
	return normalize(toCentre + centreToRay * saturate(radius / max(length(centreToRay), 1e-6f)));
}

// Shaded colour of a surface (emissive included) under the lights of the scene, its environment and its shadows.
float3 shadeSurface(Surface s) {
	int shadingModel = gMaterial.model.x;
	if (shadingModel == 1)
		return s.albedo + s.emissive;
	float3 f0 = lerp(float3(iorToF0(gMaterial.toon.z)), s.albedo, s.metallic);
	float NoV = max(dot(s.normal, s.view), 1e-4f);
	float3 dfg = dfgTerms(NoV, s.roughness);
	float3 color = float3(0.0f);
	if (gLighting.counts.x == 0 && gScene.sunDirection.w > 0.0f) {
		// No scene light: the sun of the layer, white, unshadowed.
		float3 l = normalize(-gScene.sunDirection.xyz);
		color += gScene.sunDirection.w * (shadingModel == 2 ? toonLobe(s, l) / PI : standardLobe(s, l, f0, dfg, 0.0f));
	}
	for (int index = 0; index < gLighting.counts.x; ++index) {
		int type = int(gLights[index].directionType.w);
		float shadow = lightShadow(index, s.position, s.normal);
		if (type == 3 || type == 4) {
			color += areaLightColor(s, index, f0, dfg, shadingModel, shadow);
			continue;
		}
		float3 l;
		float3 illuminance;
		lightIncidence(index, s.position, l, illuminance);
		illuminance *= shadow;
		if (shadingModel == 2) {
			color += illuminance * toonLobe(s, l) / PI;
			continue;
		}
		float3 specularLight = l;
		float sourceRadius = type == 0 ? gLights[index].spotCosines.w : 0.0f;
		if (type == 5) {
			float3 toCentre = gLights[index].positionRange.xyz - s.position;
			float radius = gLights[index].area.w;
			specularLight = sphereSpecularDirection(s, toCentre, radius);
			sourceRadius = asin(saturate(radius / max(length(toCentre), 1e-4f)));
		}
		color += illuminance * standardLobeSplit(s, l, specularLight, f0, dfg, sourceRadius);
	}
	if (shadingModel == 2) {
		float rim = pow(1.0f - NoV, 4.0f) * gMaterial.toon.x;
		color += irradianceSH(s.normal) * s.albedo * s.occlusion * gLighting.environment.x + rim * s.albedo;
	} else {
		color += standardAmbient(s, f0, dfg);
	}
	color += gScene.ambient.rgb * s.albedo * s.occlusion;
	return color + s.emissive;
}
