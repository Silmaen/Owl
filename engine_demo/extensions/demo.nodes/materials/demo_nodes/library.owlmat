Material:
  FormatVersion: 1
  graph:
    nodes:
      - id: 7620000000000000001
        type: surface.parameters
        position: [0, 0]
      - id: 7620000000000000002
        type: output.surface
        position: [600, 0]
    links:
      - {from: 7620000000000000001, fromPin: Base Color, to: 7620000000000000002, toPin: Base Color}
      - {from: 7620000000000000001, fromPin: Alpha, to: 7620000000000000002, toPin: Alpha}
      - {from: 7620000000000000001, fromPin: Normal, to: 7620000000000000002, toPin: Normal}
      - {from: 7620000000000000001, fromPin: Metallic, to: 7620000000000000002, toPin: Metallic}
      - {from: 7620000000000000001, fromPin: Roughness, to: 7620000000000000002, toPin: Roughness}
      - {from: 7620000000000000001, fromPin: Occlusion, to: 7620000000000000002, toPin: Occlusion}
      - {from: 7620000000000000001, fromPin: Emissive, to: 7620000000000000002, toPin: Emissive}
      - {from: 7620000000000000001, fromPin: Clearcoat, to: 7620000000000000002, toPin: Clearcoat}
      - {from: 7620000000000000001, fromPin: Clearcoat Roughness, to: 7620000000000000002, toPin: Clearcoat Roughness}
      - {from: 7620000000000000001, fromPin: Sheen Color, to: 7620000000000000002, toPin: Sheen Color}
      - {from: 7620000000000000001, fromPin: Sheen Roughness, to: 7620000000000000002, toPin: Sheen Roughness}
      - {from: 7620000000000000001, fromPin: Anisotropy, to: 7620000000000000002, toPin: Anisotropy}
      - {from: 7620000000000000001, fromPin: Anisotropy Rotation, to: 7620000000000000002, toPin: Anisotropy Rotation}
    customNodes:
      - name: pulse
        title: Pulse
        inputs:
          - name: time
            type: Float
            default: 0
          - name: speed
            type: Float
            default: 1
        outputs:
          - name: result
            type: Float
        code: |
          result = 0.5 + 0.5 * sin(time * speed);
