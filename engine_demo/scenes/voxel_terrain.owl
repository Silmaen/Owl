    DayNightCycle: {enabled: true, timeOfDay: 9, dayLength: 300, azimuth: 90, maxElevation: 60, sun: 3400000000000000006, sunIlluminance: 100000, sunColor: [1, 0.96, 0.9], sunsetColor: [1, 0.55, 0.3], moonIlluminance: 4000, moonColor: [0.62, 0.72, 1]}
