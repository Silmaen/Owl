    MeshRenderer:
      mesh: gid:c6e2b208c9bbd12c:meshes/characters/mannequin.glb
      color: [1, 1, 1, 1]
      transparent: false
    Animator:
      playing: true
      speed: 1
      entry: idle
      parameters:
        - {name: speed, type: Float, value: 0}
        - {name: wave, type: Trigger, value: 0}
      states:
        - {name: idle, clip: idle, speed: 1, loop: true}
        - {name: walk, clip: walk, speed: 1, loop: true}
        - {name: wave, clip: wave, speed: 1, loop: false}
      transitions:
        - from: idle
          to: walk
          duration: 0.3
          exitTime: -1
          conditions:
            - {parameter: speed, op: Greater, threshold: 0.5}
        - from: walk
          to: idle
          duration: 0.3
          exitTime: -1
          conditions:
            - {parameter: speed, op: Less, threshold: 0.5}
        - from: "*"
          to: wave
          duration: 0.2
          exitTime: -1
          conditions:
            - {parameter: wave, op: IsTrue, threshold: 0}
        - from: wave
          to: idle
          duration: 0.3
          exitTime: 1
          conditions: []
