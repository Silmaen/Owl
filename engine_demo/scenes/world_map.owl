- Entity: 2000000000000000437
  Tag: {tag: Talk_Villager}
  Transform:
    translation: [0, 0, 0.6]
    rotation: [0, 0, 0]
    scale: [2.2, 2.2, 1]
  Trigger: {Type: Interaction, InteractionRange: 1.5, CallbackName: on_talk}
  Visibility: {gameVisible: true}
  LuaScript:
    scriptPath: scripts/hub_talker.lua
    properties:
    - {name: speaker, type: string, value: "Villager"}
    - {name: lines, type: string, value: "Nice day for a walk. The four houses along the high street are the levels.|I cross the village every day. Mind the fountain, the stones are slippery.|Have you seen the lever in the east meadow? It opens the old gate in the west grove."}
    - {name: follow, type: string, value: "Villager"}
- Entity: 2000000000000000438
  Tag: {tag: Talk_Guard}
  Transform:
    translation: [0, 0, 0.6]
    rotation: [0, 0, 0]
    scale: [2.2, 2.2, 1]
  Trigger: {Type: Interaction, InteractionRange: 1.5, CallbackName: on_talk}
  Visibility: {gameVisible: true}
  LuaScript:
    scriptPath: scripts/hub_talker.lua
    properties:
    - {name: speaker, type: string, value: "Guard"}
    - {name: lines, type: string, value: "Halt! Ah, it is only you. Mind the lava in the north west forest, it is deadly.|All quiet on the square. When the four levels are done, the shrine will wake up.|The river stings. Cross it by the bridges."}
    - {name: follow, type: string, value: "Guard"}
- Entity: 2000000000000000439
  Tag: {tag: Talk_Wizard}
  Transform:
    translation: [0, 0, 0.6]
    rotation: [0, 0, 0]
    scale: [2.2, 2.2, 1]
  Trigger: {Type: Interaction, InteractionRange: 1.5, CallbackName: on_talk}
  Visibility: {gameVisible: true}
  LuaScript:
    scriptPath: scripts/hub_talker.lua
    properties:
    - {name: speaker, type: string, value: "Wizard"}
    - {name: lines, type: string, value: "The portal in the shrine sleeps until you have finished the four levels.|Platformer, raycast, isometric town, voxels: four houses, four worlds.|My spells are only a little Lua. The bell is not mine, though."}
    - {name: follow, type: string, value: "Wizard"}
- Entity: 2000000000000000440
  Tag: {tag: Talk_Knight}
  Transform:
    translation: [0, 0, 0.6]
    rotation: [0, 0, 0]
    scale: [2.2, 2.2, 1]
