    scriptPath: scripts/hub_talker.lua
    properties:
    - {name: speaker, type: string, value: "Farmer"}
    - {name: lines, type: string, value: "Wheat, cabbages and carrots. The hens are not for sale.|Rain is late this year. The river is full, though.|Do not step on my beds, friend."}
    - {name: follow, type: string, value: "Farmer"}
- Entity: 2000000000000000442
  Tag: {tag: Talk_Merchant1}
  Transform:
