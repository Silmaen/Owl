    - {name: lines, type: string, value: "Fresh bread! Nothing for sale today, but the smell is free.|The bakery opens before the bell. Come early next time."}
    - {name: follow, type: string, value: "Merchant1"}
- Entity: 2000000000000000443
  Tag: {tag: Talk_Merchant2}
  Transform:
