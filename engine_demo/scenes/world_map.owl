    properties:
    - {name: speaker, type: string, value: "Knight"}
    - {name: lines, type: string, value: "I guard the high street. The raycast house is on the left, the iso town on the right.|A hero walks the village! Try the board near the entrance.|Finish every level and come back: the portal will answer."}
    - {name: follow, type: string, value: "Knight"}
- Entity: 2000000000000000441
  Tag: {tag: Talk_Farmer}
  Transform:
    translation: [0, 0, 0.6]
    rotation: [0, 0, 0]
