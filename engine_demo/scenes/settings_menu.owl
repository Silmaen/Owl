Scene: untitled
EnabledRenderers:
  - Name: raycast_world
    Enabled: false
Entities:
  - Entity: 1234567890123456789
    Tag:
      tag: SettingsCanvas
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Canvas:
      space: ScreenOverlay
      sortOrder: 0
      referenceResolution: [1280, 720]
      scaleMode: ScaleWithHeight
    Visibility:
      gameVisible: true
    Hierarchy:
      {}
    LuaScript:
      scriptPath: scripts/settings_menu.lua
  - Entity: 8901234567890123456
    Tag:
      tag: Background
    Transform:
      translation: [0, 0, -1]
      rotation: [0, 0, 0]
      scale: [20, 15, 1]
    SpriteRenderer:
      color: [0.0599999987, 0.0599999987, 0.140000001, 1]
    Visibility:
      gameVisible: true
  - Entity: 7823456789012345678
    Tag:
      tag: MainCamera
    Transform:
      translation: [0, 0, 5]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Camera:
      camera:
        projectionType: Orthographic
        perspectiveFOV: 0.785398185
        perspectiveNear: 0.00999999978
        perspectiveFar: 1000
        orthographicSize: 10
        orthographicNear: -1
        orthographicFar: 10
      primary: true
      fixedAspectRatio: false
    Visibility:
      gameVisible: true
  - Entity: 800000000000000010
    Tag: {tag: SettingsList}
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility: {gameVisible: true}
    Hierarchy: {parentId: 1234567890123456789}
    UiRect:
      anchorMin: [0.5, 0]
      anchorMax: [0.5, 0]
      pivot: [0.5, 0]
      size: [0.9, 0.78]
      sizeUnit: [ScreenHeight, ScreenHeight]
      offset: [0, 0.15]
      offsetUnit: [Pixels, ScreenHeight]
    UiLayout:
      arrangement: Column
      crossAlign: Center
      spacing: 4
      padding: 4
      columns: 1
      cellSize: [0, 0]
  - Entity: 9012345678901234567
    Tag: {tag: BackButton}
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility: {gameVisible: true}
    Hierarchy: {parentId: 800000000000000010}
    UiButton:
      normalColor: [0.400000006, 0.200000003, 0.200000003, 1]
      hoverColor: [0.550000012, 0.300000012, 0.300000012, 1]
      pressedColor: [0.300000012, 0.150000006, 0.150000006, 1]
      disabledColor: [0.150000006, 0.150000006, 0.150000006, 0.5]
      onClickCallback: go_back
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [0.5, 0.11]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiText:
      text: Back
      color: [1, 1, 1, 1]
      fontSize: 30
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0
      fit: Shrink
      minFontSize: 12
  - Entity: 800000000000000001
