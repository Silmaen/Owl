Scene: IsoTest
Hud: huds/iso_test.owlhud
EnabledRenderers:
- {Name: raycast_world, Enabled: false}
- {Name: world, Enabled: true}
- Name: iso_world
  Enabled: true
  Overrides: {Zoom: 1}
- Name: ui
  Enabled: true
  Overrides: {Space: Screen}
Entities:
- Entity: 4100000000000000001
  Tag: {tag: MainCamera}
  Transform:
    translation: [4, 4, 5]
    rotation: [0, 0, 0]
    scale: [1, 1, 1]
  Camera:
    camera: {projectionType: Orthographic, perspectiveFOV: 0.785398185, perspectiveNear: 0.00999999978, perspectiveFar: 1000,
      orthographicSize: 10, orthographicNear: -1, orthographicFar: 10}
    primary: true
    fixedAspectRatio: false
  Visibility: {gameVisible: true}
  LuaScript:
    scriptPath: scripts/iso_camera.lua
    properties:
    - name: speed
      type: float
      value: 6
- Entity: 4100000000000000002
  Tag: {tag: Sky}
  Transform:
    translation: [4, 4, -5]
    rotation: [0, 0, 0]
