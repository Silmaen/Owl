Scene: IsoTown
Hud: huds/iso_town.owlhud
EnabledRenderers:
- {Name: raycast_world, Enabled: false}
- {Name: world, Enabled: true}
- Name: iso_world
  Enabled: true
  Overrides: {Zoom: 0}
- Name: ui
  Enabled: true
  Overrides: {Space: Screen}
- {Name: overlay, Enabled: true}
Entities:
- Entity: 4300000000000000001
  Tag: {tag: MainCamera}
  Transform:
    translation: [32, 30, 5]
    rotation: [0, 0, 0]
    scale: [1, 1, 1]
  Camera:
    camera: {projectionType: Orthographic, perspectiveFOV: 0.785398185,
      perspectiveNear: 0.00999999978,
      perspectiveFar: 1000, orthographicSize: 11, orthographicNear: -1, orthographicFar: 10}
    primary: true
    fixedAspectRatio: false
  SoundListener:
    primary: true
  LuaScript:
    scriptPath: scripts/iso_camera.lua
    properties:
    - name: speed
      type: float
      value: 14
    - name: limit
      type: float
      value: 64
  Visibility: {gameVisible: true}

