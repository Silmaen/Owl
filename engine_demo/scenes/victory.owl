Scene: untitled
EnabledRenderers:
  - Name: raycast_world
    Enabled: false
Entities:
  - Entity: 200000000000000001
    Tag:
      tag: MainCamera
    Transform:
      translation: [0, 0, 5]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Camera:
      camera:
        projectionType: Orthographic
        perspectiveFOV: 0.785398185
        perspectiveNear: 0.00999999978
        perspectiveFar: 1000
        orthographicSize: 10
        orthographicNear: -1
        orthographicFar: 10
      primary: true
      fixedAspectRatio: false
    Visibility:
      gameVisible: true
  - Entity: 200000000000000002
    Tag:
      tag: Background
    Transform:
      translation: [0, 0, -1]
      rotation: [0, 0, 0]
      scale: [20, 15, 1]
    BackgroundTexture:
      mode: 0
      type: 0
      color: [0.0509803928, 0.101960786, 0.0509803928, 1]
      topColor: [0.800000012, 0.899999976, 1, 1]
    Visibility:
      gameVisible: true
  - Entity: 200000000000000003
    Tag:
      tag: VictoryCanvas
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Canvas:
      space: ScreenOverlay
      sortOrder: 0
      referenceResolution: [1280, 720]
      scaleMode: ScaleWithHeight
    Visibility:
      gameVisible: true
    Hierarchy:
      {}
    LuaScript:
      scriptPath: scripts/ui/victory.lua
  - Entity: 200000000000000010
    Tag: {tag: ResultGroup}
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility: {gameVisible: true}
    Hierarchy: {parentId: 200000000000000003}
    UiRect:
      anchorMin: [0.5, 0.5]
      anchorMax: [0.5, 0.5]
      pivot: [0.5, 0.5]
      size: [0.7, 0.7]
      sizeUnit: [ScreenWidth, ScreenHeight]
      offset: [0, 0]
    UiLayout:
      arrangement: Column
      crossAlign: Center
      spacing: 8
      padding: 0
      columns: 1
      cellSize: [0, 0]
  - Entity: 200000000000000011
    Tag: {tag: ButtonRow}
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility: {gameVisible: true}
    Hierarchy: {parentId: 200000000000000010}
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [1, 0.2]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiLayout:
      arrangement: Row
      crossAlign: Center
      spacing: 8
      padding: 0
      columns: 1
      cellSize: [0, 0]
  - Entity: 200000000000000006
    Tag: {tag: MenuButton}
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility: {gameVisible: true}
    Hierarchy: {parentId: 200000000000000011}
    UiButton:
      normalColor: [0.150000006, 0.349999994, 0.649999976, 1]
      hoverColor: [0.25, 0.449999988, 0.75, 1]
      pressedColor: [0.100000001, 0.25, 0.5, 1]
      disabledColor: [0.150000006, 0.150000006, 0.150000006, 0.5]
      onClickCallback: on_menu_clicked
    UiFocus: {initial: true}
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [0.5, 1]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiText:
      text: Main Menu
      color: [1, 1, 1, 1]
      fontSize: 32
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0
      fit: Shrink
      minFontSize: 12
  - Entity: 200000000000000005
    Tag: {tag: ScoreLabel}
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility: {gameVisible: true}
    Hierarchy: {parentId: 200000000000000010}
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [1, 0.2]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiText:
      text: 'Final Score: 0'
      color: [1, 1, 1, 1]
      fontSize: 36
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0
      fit: Shrink
      minFontSize: 12
  - Entity: 200000000000000004
    Tag: {tag: VictoryTitle}
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility: {gameVisible: true}
    Hierarchy: {parentId: 200000000000000010}
    UiRect:
      anchorMin: [0, 0]
      anchorMax: [0, 0]
      pivot: [0, 0]
      size: [1, 0.34]
      sizeUnit: [ParentWidth, ParentHeight]
      offset: [0, 0]
    UiText:
      text: Victory!
      color: [0.200000003, 1, 0.200000003, 1]
      fontSize: 72
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0
      fit: Shrink
      minFontSize: 12
