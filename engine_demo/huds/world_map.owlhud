    referenceResolution: [1280, 720]
    scaleMode: ScaleWithHeight
  Visibility:
    gameVisible: true
  Hierarchy:
    {}
- Entity: 2000000000000000062
  Tag:
    tag: HudHint
  Transform:
    translation: [0, 0, 0]
    rotation: [0, 0, 0]
    scale: [1, 1, 1]
  Visibility:
    gameVisible: true
  Hierarchy:
    parentId: 2000000000000000060
  UiRect:
