Scene: untitled
EnabledRenderers:
  - Name: raycast_world
    Enabled: false
Entities:
  - Entity: 300000000000000001
    Tag:
      tag: MainCamera
    Transform:
      translation: [0, 0, 5]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Camera:
      camera:
        projectionType: Orthographic
        perspectiveFOV: 0.785398185
        perspectiveNear: 0.00999999978
        perspectiveFar: 1000
        orthographicSize: 10
        orthographicNear: -1
        orthographicFar: 10
      primary: true
      fixedAspectRatio: false
    Visibility:
      gameVisible: true
  - Entity: 300000000000000002
    Tag:
      tag: Background
    Transform:
      translation: [0, 0, -1]
      rotation: [0, 0, 0]
      scale: [20, 15, 1]
    BackgroundTexture:
      mode: 0
      type: 0
      color: [0.149019614, 0.0392156877, 0.0392156877, 1]
      topColor: [0.800000012, 0.899999976, 1, 1]
    Visibility:
      gameVisible: true
  - Entity: 300000000000000003
    Tag:
      tag: GameOverCanvas
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Canvas:
      space: ScreenOverlay
      sortOrder: 0
      referenceResolution: [1280, 720]
      scaleMode: ScaleWithHeight
    Visibility:
      gameVisible: true
    Hierarchy:
      {}
    LuaScript:
      scriptPath: scripts/game_over.lua
  - Entity: 300000000000000004
    Tag:
      tag: GameOverTitle
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 300000000000000003
    UiRect:
      anchorMin: [0.5, 0]
      anchorMax: [0.5, 0]
      pivot: [0.5, 0]
      size: [500, 80]
      offset: [0, 80]
    UiText:
      text: Game Over
      color: [1, 0.200000003, 0.200000003, 1]
      fontSize: 48
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0
  - Entity: 300000000000000005
    Tag:
      tag: ScoreLabel
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 300000000000000003
    UiRect:
      anchorMin: [0.5, 0.5]
      anchorMax: [0.5, 0.5]
      pivot: [0.5, 0.5]
      size: [300, 40]
      offset: [0, -30]
    UiText:
      text: "Score: 0"
      color: [1, 1, 1, 1]
      fontSize: 24
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0
  - Entity: 300000000000000006
    Tag:
      tag: RetryButton
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 300000000000000003
    UiButton:
      normalColor: [0.600000024, 0.300000012, 0.100000001, 1]
      hoverColor: [0.75, 0.400000006, 0.200000003, 1]
      pressedColor: [0.449999988, 0.200000003, 0.0500000007, 1]
      disabledColor: [0.150000006, 0.150000006, 0.150000006, 0.5]
      onClickCallback: on_retry_clicked
    UiFocus:
      initial: true
    UiRect:
      anchorMin: [0.5, 0.5]
      anchorMax: [0.5, 0.5]
      pivot: [0.5, 0.5]
      size: [160, 40]
      offset: [-100, 40]
    UiText:
      text: Retry
      color: [1, 1, 1, 1]
      fontSize: 20
      horizontalAlignment: Center
      verticalAlignment: Middle
      kerning: 0
      lineSpacing: 0
  - Entity: 300000000000000007
    Tag:
      tag: MenuButton
    Transform:
      translation: [0, 0, 0]
      rotation: [0, 0, 0]
      scale: [1, 1, 1]
    Visibility:
      gameVisible: true
    Hierarchy:
      parentId: 300000000000000003
    UiButton:
      normalColor: [0.300000012, 0.300000012, 0.300000012, 1]
      hoverColor: [0.400000006, 0.400000006, 0.400000006, 1]
      pressedColor: [0.200000003, 0.200000003, 0.200000003, 1]
      disabledColor: [0.150000006, 0.150000006, 0.150000006, 0.5]
      onClickCallback: on_menu_clicked
    UiRect:
      anchorMin: [0.5, 0.5]
